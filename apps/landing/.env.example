# Community Landing (public marketing site + dataset catalog) — copy to .env and fill in.
# Never commit .env itself. All NEXT_PUBLIC_* values are baked into the client bundle at build time.

# --- Where the other apps live ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-rendered reads use this private runtime address when set.
INTERNAL_API_URL=http://localhost:4000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3010
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_LANDING_URL=http://localhost:3001

# --- Build-time output mode (optional; leave unset for a normal `next start` server) ---
# NEXT_OUTPUT=standalone
