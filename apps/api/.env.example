# Community API — copy to .env and fill in. Never commit .env itself.
# Every value below is a placeholder. Generate real secrets with:
#   openssl rand -hex 32

# --- Core ---
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/community?schema=public"

# Migration/CLI connection (DIRECT_URL). Not needed for local Postgres or the
# bundled docker-compose database — omitted here on purpose; the Prisma CLI
# falls back to DATABASE_URL (see `prisma.config.ts`). Only needed when
# DATABASE_URL is a TRANSACTION pooler (e.g. Supabase port 6543,
# `pgbouncer=true`), which can't hold the session-scoped advisory lock Prisma
# Migrate takes — see `docs/configuration.md` for the full explanation and the
# variable's documented row before adding it back for that kind of database.

# Shadow database for `prisma migrate dev` (OPTIONAL, and only ever needed when
# AUTHORING a migration). `migrate dev` creates and drops a temporary shadow
# database to detect drift; if the CLI role cannot CREATE DATABASE — a pooled
# managed-Postgres role, for instance — point this at a database it can use.
# Deploys run `migrate deploy`, which needs no shadow database at all.
SHADOW_DATABASE_URL=


# --- URLs ---
APP_URL=http://localhost:53000
# Public landing app. Owns /domains/:id, /pools and public profiles — the
# waitlist "your domain is live" email links here, NOT to APP_URL (the member
# dashboard), which has no /domains route. Production refuses to boot on the
# localhost default (see src/config.ts).
LANDING_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
CORS_ORIGINS=http://localhost:53000,http://localhost:3002,http://localhost:3001,http://localhost:3000
# The trailing :3000 origin above is not a real app in this repo (web/admin/
# landing bind to 53000/3002/3001 — see each app's package.json `dev` script).
# It stays here anyway because it's the ONE origin the api test suite's MCP
# OAuth fixtures hardcode as the simulated dashboard origin (`origin:
# "http://localhost:3000"` across src/mcp/transport.integration.test.ts and
# the mcp-oauth-*/mcp-cimd/mcp-scope-matrix/mcp-multiclient-apikeys suites),
# and it's also config.ts's own built-in corsOrigins fallback
# (used only when CORS_ORIGINS is unset). Without it, a contributor who
# follows CONTRIBUTING.md exactly — cp .env.example .env, fill in
# DATABASE_URL, npm test — gets 84 failing tests across 7 files, all
# `expected 200 to be 403` on the MCP consent/token endpoints, purely from
# `config.corsOrigins` (routes/mcp.ts) rejecting that fixture Origin header.
# Found via a clean-clone build/test verification pass, 2026-09-08.
# This API's own public base URL (no /v1 suffix, no trailing slash). Used to
# build absolute links that must resolve OUTSIDE this process: the
# routine-digest unsubscribe URL mailed to real users, and MCP
# artifact-upload URLs handed to out-of-process MCP clients. Production
# refuses to boot on the localhost default (see src/config.ts).
PUBLIC_API_BASE_URL=http://localhost:4000
# Public dashboard/MCP gateway origin, bound into every issued MCP OAuth
# credential as its RFC 8707 audience. Give the ORIGIN (no path); the
# server appends /mcp itself. A value ending in /mcp is accepted and
# normalised, so pasting the client-facing MCP URL is safe.
#
# This MUST be the DASHBOARD origin (the same value as APP_URL), not this
# API's origin. The dashboard proxies /mcp and both .well-known documents, so
# the URL a client pastes is <dashboard>/mcp and that is the audience it sends
# as its RFC 8707 `resource`. Naming the API's own port here makes the server
# advertise one resource and validate another, and every client is answered
# `invalid_target` on /authorize with no way to connect. Production refuses to
# boot on the localhost default or on an origin that disagrees with APP_URL
# (see src/config.ts).
MCP_PUBLIC_URL=http://localhost:3010

# --- Session signing (required in production; src/config.ts refuses to boot
#     when NODE_ENV is production and either of these is still the committed
#     dev_* literal, so a publicly known signing key can never sign real
#     session cookies. Outside production the dev_* fallbacks are used) ---
SESSION_SECRET=CHANGEME_generate_with_openssl_rand_hex_32
ADMIN_SESSION_SECRET=CHANGEME_generate_with_openssl_rand_hex_32

# --- Integrity secrets (required in production, same fail-closed guard).
#     POOL_SAMPLING_HMAC_SECRET seeds the deterministic draw deciding which
#     submissions enter a human-audit window: with a publicly known key a
#     contributor can compute which of their own items will never be reviewed,
#     which defeats audit sampling as an integrity control.
#     PROFILE_SOURCE_SECRET both signs credential-connect state tokens and
#     derives the key encrypting stored provider tokens ---
POOL_SAMPLING_HMAC_SECRET=CHANGEME_generate_with_openssl_rand_hex_32
PROFILE_SOURCE_SECRET=CHANGEME_generate_with_openssl_rand_hex_32

# --- LLM review (optional; when unset the llm stage records
#     "no_provider_configured" and routes to human review — it never auto-accepts) ---
OPENROUTER_API_KEY=

# --- Execution sandbox (optional; when unset the execution stage records
#     "no_provider_configured" and routes to human review — nothing runs on the API host) ---
E2B_API_KEY=
E2B_TEMPLATE=databounty-verify

# --- Email delivery (optional; when unset notification deliveries dead-letter
#     with an explicit reason rather than reporting a false "sent") ---
SMTP_HOST=
SMTP_PORT=587
# Implicit TLS on connect (SMTPS). Leave blank to derive it from the port
# (true only for 465); set true/false to state it explicitly.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- Google sign-in (optional; when unset the sign-in UI reports that Google
#     sign-in is not configured rather than showing a broken button.
#     Email/password signup works without it) ---
GOOGLE_CLIENT_ID=

# --- Credential verification OAuth (optional; register your own apps —
#     do NOT reuse another deployment's client secrets) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
ORCID_OAUTH_CLIENT_ID=
ORCID_OAUTH_CLIENT_SECRET=

# --- Notification channels (optional) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Stalled community pools: force-closes pools past `Bounty.deadline` that never
# reached targetItems, so their accepted work still reaches validation and the
# karma for it is released. Without the sweep such a pool sits open forever.
POOL_RECONCILE_INTERVAL_MS=600000

# --- Dataset publication (optional; when unset a publish records
#     `not_configured` for that target and never claims it was pushed) ---
# A community dataset is pushed to every configured target. Each target gets
# the same data/items.jsonl and manifest.json bytes; only the repository
# furniture differs (Hugging Face gets a dataset card with the Hub's YAML
# front matter, GitHub gets a plain README plus LICENSE and .gitattributes).
#
# Hugging Face — the primary target. A write token and the namespace (user or
# org) datasets are created under.
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_NAMESPACE=
# HUGGINGFACE_API_URL=https://huggingface.co/api
#
# GitHub — every dataset lands as its own FOLDER (datasets/<slug>/) inside
# ONE shared repo, <owner>/<GITHUB_PUBLICATION_REPO>. This must be a DEDICATED
# credential, never a personal or CI token: contents:write scoped to just that
# one repo is enough (no repo-creation rights needed in the normal case). Git
# LFS is out of scope, so any single file at or over GitHub's 100 MB API limit
# fails the publish permanently rather than being silently dropped.
GITHUB_PUBLICATION_TOKEN=
GITHUB_PUBLICATION_OWNER=
# GITHUB_PUBLICATION_REPO=databounty-datasets   # the one shared repo; this is the default
# GITHUB_PUBLICATION_API_URL=https://api.github.com   # set for GitHub Enterprise
# GITHUB_PUBLICATION_BRANCH_PROTECTED=false   # set true once `main` on the shared repo requires PRs; publishes then go branch+PR+merge instead of a direct push
#
# Shared HTTP timeouts for both targets (ms).
# PUBLICATION_REQUEST_TIMEOUT_MS=10000
# PUBLICATION_UPLOAD_TIMEOUT_MS=300000

# --- Parity off-switches ---
# Member analytics (GET /v1/me/analytics, and the "Your activity" charts in the
# contributor/validator workspaces). ON unless this is set to "false". V1 has
# no member analytics surface, so this is a real divergence from the parity
# baseline and is owed a deviation row; the switch is here so it can be closed
# again without a revert.
MEMBER_ANALYTICS_ENABLED=
