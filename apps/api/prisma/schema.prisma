model Bounty {
  id                            String                     @id @default(cuid())
  requesterUserId               String                     @map("requester_user_id")
  kind                          BountyKind                 @default(community)
  // Set only for a community bounty minted from an approved request. This is
  // intentionally separate from requesterUserId, which remains the legacy
  // ownership relation relied on by supported sponsor routes.
  communityRequesterUserId      String?                    @map("community_requester_user_id")
  karmaPerAcceptedItem          Int                        @default(0) @map("karma_per_accepted_item")
  communityLicense              String?                    @map("community_license")
  communityLicenseUrl           String?                    @map("community_license_url")
  publicationStatus             CommunityPublicationStatus @default(not_requested) @map("publication_status")
  huggingFaceDataset            String?                    @map("hugging_face_dataset")
  datasetTypeId                 String?                    @map("dataset_type_id")
  datasetTypeVersion            Int?                       @map("dataset_type_version")
  // Immutable pricing inputs captured when the bounty is created. Award paths
  // must use this rather than the live DatasetType/admin matrix so an admin
  // correction only affects newly minted work.
  karmaQuote                    Json?                      @map("karma_quote")
  title                         String
  description                   String
  datasetCategory               DatasetCategory            @map("dataset_category")
  language                      String
  framework                     String
  // BigInt (not Int): a bounty's total item target must not overflow the
  // Int32 ceiling (~2.1B) at billions-of-users scale (scalability plan §2.3).
  targetItems                   BigInt                     @map("target_items")
  // Sponsor-provided, scan-approved reference examples are part of the final
  // target count. Legacy bounties default to zero; planner-created bounties
  // snapshot the requirement at creation so later config changes cannot alter
  // an already-priced contract.
  // New bounties need three approved sponsor reference examples before
  // support. Existing rows retain their snapshotted requirement; the SQL
  // migration changes only the database default, never historical contracts.
  requiredSponsorExamples       Int                        @default(3) @map("required_sponsor_examples")
  status                        BountyStatus               @default(draft)
  visibility                    String                     @default("private")
  auditMode                     AuditMode                  @map("audit_mode")
  auditCoveragePct              Int                        @map("audit_coverage_pct")
  // Immutable community-only routing policy captured at mint. NULL preserves
  // pre-policy pools on their existing sampled/windowed lifecycle.
  communityValidationMode       String?                    @map("community_validation_mode")
  // Community-only snapshot of the administrator's rolling human-audit window.
  // Null is supported/legacy; 0 deliberately preserves community pool-close sampling.
  humanAuditWindowSize          Int?                       @map("human_audit_window_size")
  // Community-only immutable snapshot of the administrator's audit-window
  // failure threshold. A window fails when rejected validator decisions are
  // greater than or equal to this percentage of its selected review items.
  // Null remains valid only for supported/legacy rows; new community pools always
  // snapshot the setting at mint so an administrator cannot alter an in-flight
  // sponsor contract.
  humanAuditFailureThresholdPct Int?                       @map("human_audit_failure_threshold_pct")
  // The single difficulty an open pool is worked at (OD-10 /
  // KARMA_PRICING_MATRIX_PLAN §3.4). A supported bounty spreads its difficulty mix
  // across BountySlot + ContributorBatch rows, but an open-pool community bounty
  // deliberately has NO ContributorBatch — pool-submission.ts creates submissions
  // with `contributorBatchId: null` — so every pool award read
  // `submission.batch?.difficulty`, got undefined, and silently priced at the
  // intermediate rate no matter what mix the requester chose (G-17). Pools are
  // homogeneous by contract (one contract, one cap), so they carry exactly one
  // level, resolved from the request's difficulty mix at mint.
  //
  // Nullable on purpose, and null is NOT a default difficulty: a supported bounty
  // never uses this column, and a pool row predating it keeps null. Readers
  // must fall back explicitly rather than treat null as a middle level.
  poolDifficulty                String?                    @map("pool_difficulty")
  holdDays                      Int                        @map("hold_days") // 30 | 365
  // Hour-precision dispute/karma-hold window for COMMUNITY bounties only.
  // Snapshotted at mint from the "community.dispute_window_hours" admin
  // setting (admin-settings.ts). Community bounties are minted with
  // holdDays: 0 (no supported-style distribution/disbursement hold applies), so this is a
  // dedicated field rather than overloading holdDays — 14 hours forced into
  // that Int-days column would round up to a full 24h window. Null on
  // supported/licensed bounties, which keep using holdDays*days as before.
  disputeWindowHours            Int?                       @map("dispute_window_hours")
  // distribution-hold clock — separate from holdDays (which gates disbursement release /
  // dispute window). Snapshotted at creation from admin settings; set once,
  // at delivery, never at support. See src/lib/licensing.ts.
  deadline                      DateTime?
  revisionNote                  String?                    @map("revision_note")
  // When the bounty entered `pilot_review` — the clock the 7-day
  // auto-approve SLA and its day 3/5/7 reminders count from. Cleared when the
  // sponsor acts (approve/request-changes) or a dispute pauses the clock.
  // BigInt for the same overflow reason as targetItems above.
  // INTAKE / close-out counter: accepted + supported + accepted_pending_sample +
  // in_sponsor_review. Drives pool close-out, pilot completion, and capacity —
  // it deliberately counts items that only cleared automation (not yet final).
  // Do NOT surface this as "accepted" to users; use finalAcceptedItems for that.
  acceptedItems                 BigInt                     @default(0) @map("accepted_items")
  // TRUE acceptance counter: accepted + supported ONLY — an item a validator passed
  // (or that has been published). This is the number every user-facing
  // "accepted" surface must read; `acceptedItems` above over-claims because it
  // also counts pipeline-passed-but-not-final work. Maintained alongside
  // acceptedItems in recomputeAcceptedItemCounters so the two can't drift.
  finalAcceptedItems            BigInt                     @default(0) @map("final_accepted_items")
  // Community open-pool lifecycle (COMMUNITY_OPEN_POOL_PLAN_V2 §3.3/§8/§9).
  // All three are null until a community pool reaches targetItems, then set
  // together in that order as the pool closes and samples. NOT one-shot in
  // practice, whatever this comment used to claim: recomputeAcceptedItemCounters
  // (services/submission-acceptance.ts) clears all three back to null if a
  // closed pool's recounted capacity falls back under target (a slot-holding
  // item left the counted set after close — flagged in human audit, rejected
  // on a dispute overturn) — verified live as a real stuck-closed pool bug.
  // Follows the same nullable-timestamp-marks-a-state-entry pattern as
  // pilotReviewStartedAt above rather than a separate enum, since the only
  // branching this state machine needs (closed <-> reopened, then normally
  // sampling -> released) is exactly what the reopen path above adds.
  poolClosedAt                  DateTime?                  @map("pool_closed_at")
  poolSamplingStartedAt         DateTime?                  @map("pool_sampling_started_at")
  poolSamplingCompletedAt       DateTime?                  @map("pool_sampling_completed_at")
  // Batch-level dispute-and-publish cycle (supersedes the earlier per-item
  // Bounty.disputeWindowHours gate below for community bounties — that field
  // is kept as a defensive floor, not the primary gate). UNLIKE the pool
  // fields immediately above, disputeCycleWindowOpensAt is NOT one-shot: it
  // is (re)set every time `releaseBucketIfSampleComplete` fires — first when
  // the pool's sampled/sponsor-reviewed items all settle, and again each
  // time a dispute-driven revision round (item requeued to `in_audit`, then
  // redecided) leaves the bounty clean again. The heartbeat sweep
  // (services/community-publish.ts) only flips disputeCycleSettledAt once
  // disputeCycleWindowOpensAt + community.dispute_window_hours has elapsed
  // AND zero `Dispute{status: open}` rows remain for the bounty, then
  // enqueues publication automatically — no admin action. A fresh dispute
  // filed after settlement is rejected by the dispute route on window-closed
  // grounds, same as it always was; there is no explicit "already settled"
  // check needed because the window math alone already covers it.
  disputeCycleWindowOpensAt     DateTime?                  @map("dispute_cycle_window_opens_at")
  disputeCycleSettledAt         DateTime?                  @map("dispute_cycle_settled_at")
  // Sponsor-initiated early close (owner decision, 2026-09-10). Null means the
  // sponsor has never asked to close this pool early. Set means they have, via
  // POST /v1/bounties/:id/close-pool — and it changes what an under-target
  // settle means: settleDueCommunityPools (services/pool-lifecycle.ts) REOPENS
  // an under-target pool whose dispute window elapses UNLESS this is set, in
  // which case it settles `partially_completed` exactly as before. This is
  // deliberately separate from poolClosedAt (which just means "capacity
  // reserved, in its dispute-review window" and is NOT one-shot — see the
  // reopen comment on `recomputeAcceptedItemCounters` above) — sponsorClosedAt
  // records sponsor INTENT, and unlike poolClosedAt it is one-shot: once a
  // sponsor asks to stop taking contributions, that decision does not get
  // silently undone by a later capacity recount.
  sponsorClosedAt               DateTime?                  @map("sponsor_closed_at")
  createdAt                     DateTime                   @default(now()) @map("created_at")
  updatedAt                     DateTime                   @updatedAt @map("updated_at")

  requester              User                    @relation("SponsorBounties", fields: [requesterUserId], references: [id])
  communityRequester     User?                   @relation("CommunityBountyRequester", fields: [communityRequesterUserId], references: [id])
  datasetType            DatasetType?            @relation(fields: [datasetTypeId], references: [id])
  plan                   BountyPlan?
  batchPlan              BountyBatchPlan?
  slots                  BountySlot[]
  batches                ContributorBatch[]
  submissions            Submission[]
  humanAuditWindows      HumanAuditWindow[]
  auditBatches           AuditBatch[]
  disputes               Dispute[]
  artifacts              Artifact[]
  pendingKarmaAwards     PendingKarmaAward[]
  sourceRequest          DatasetRequest?         @relation("CommunityRequestBounty")
  submissionUploadDrafts SubmissionUploadDraft[]
  publications           DatasetPublication[]

  @@index([requesterUserId])
  @@index([status])
  @@index([requesterUserId, status, createdAt])
  // Public catalog / discovery lists filter on visibility before anything
  // else (scalability plan §2.3 — missing index).
  @@index([visibility])
  @@index([kind, visibility, status, createdAt])
  // Same repair as HumanAuditWindow above: created by
  // 20260811123000_add_community_validation_mode, never declared.
  @@index([kind, communityValidationMode, status], map: "bounties_kind_community_validation_mode_status_idx")
  /// Trigram index for the `title ILIKE '%q%'` search in the admin, sponsor and
  /// pool listings. A leading-wildcard LIKE cannot use a btree index at all, so
  /// without this the search is a sequential scan over `bounties`.
  ///
  /// This MUST stay declared here. V1 created the same index in raw SQL
  /// (20260718014500_add_bounties_title_trgm_index) without declaring it, so
  /// the next `prisma migrate dev` saw an object the datamodel did not know
  /// about and auto-emitted `DROP INDEX "bounties_title_trgm_idx"` inside an
  /// unrelated migration (20260718043145_add_submission_lsh_bands), destroying
  /// it 2h46m later. Deleting this line re-arms that exact failure.
  /// Requires pg_trgm, created by 20260907130000_add_bounties_title_trgm_index.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "bounties_title_trgm_idx")
  @@map("bounties")
}

model DatasetPublication {
  id       String                     @id @default(cuid())
  bountyId String                     @map("bounty_id")
  target   PublicationTarget
  status   CommunityPublicationStatus @default(pending)

  /// Provider-specific dataset reference: a Hugging Face repo id, a GitHub
  /// `owner/repo`, an AIKosh dataset id. Null until the target resolves one.
  externalId String? @map("external_id")
  /// Public URL. Written ONLY from a confirmed provider response (automated
  /// targets) or an admin-recorded attestation (assisted-manual), never
  /// derived optimistically from a slug that may not exist yet.
  url        String?

  /// When this target last completed successfully. Distinct from `updatedAt`,
  /// which also moves on failures and retries.
  pushedAt     DateTime? @map("pushed_at")
  /// Operator-facing reason for the current `failed` / `not_configured` state.
  lastError    String?   @map("last_error")
  attemptCount Int       @default(0) @map("attempt_count")

  /// The admin who attested to an `assisted_manual` upload. Non-null ONLY for
  /// those targets: it is what lets a surface distinguish "a provider confirmed
  /// this" from "a person said they did this", which are not the same claim.
  publishedByUserId String? @map("published_by_user_id")
  /// Artifact holding the prepared portal bundle for an assisted-manual target.
  bundleArtifactId  String? @map("bundle_artifact_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bounty         Bounty    @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  publishedBy    User?     @relation("DatasetPublicationPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  bundleArtifact Artifact? @relation("DatasetPublicationBundle", fields: [bundleArtifactId], references: [id], onDelete: SetNull)

  /// One row per bounty per target — the fan-out upserts on this, which is what
  /// makes a re-queued publish reuse its row instead of stacking duplicates.
  @@unique([bountyId, target])
  @@index([status])
  @@index([target, status])
  @@map("dataset_publications")
}

model HumanAuditWindow {
  id                    String                       @id @default(cuid())
  bountyId              String                       @map("bounty_id")
  windowIndex           Int                          @map("window_index")
  eligibleCount         Int                          @map("eligible_count")
  quota                 Int
  carryNumerator        Int                          @default(0) @map("carry_numerator")
  closureReason         String                       @map("closure_reason")
  selectionVersion      String                       @default("hmac-sha256-v1") @map("selection_version")
  closedAt              DateTime                     @default(now()) @map("closed_at")
  // A window is settled exactly once after every selected validator decision
  // is durable. `failedAt` records an all-window rejection; a null value after
  // settlement means only individually flagged submissions were excluded.
  settledAt             DateTime?                    @map("settled_at")
  failedAt              DateTime?                    @map("failed_at")
  rejectedSelectedCount Int?                         @map("rejected_selected_count")
  // A corrective backfill never deletes a completed selection. It records why
  // this window no longer governs routing, then allows its items to enter a
  // later, policy-compliant window.
  supersededAt          DateTime?                    @map("superseded_at")
  supersededReason      String?                      @map("superseded_reason")
  // Per-validator claim (owner requirement: "the validator claims a batch,
  // 50–100, adjustable from admin"). All three nullable/additive — a window
  // with `claimedByUserId: null` is unclaimed/available, exactly like every
  // pre-existing row after this migration. Mirrors v1's
  // AuditBatch.validatorUserId/claimedAt/deadline (routes/v1/audits.ts:410-550)
  // onto this schema's window model. `onDelete: SetNull` rather than Cascade:
  // a deleted user must not delete audit-window history, only vacate the claim.
  claimedByUserId       String?                      @map("claimed_by_user_id")
  claimedAt             DateTime?                    @map("claimed_at")
  // 24h claim-to-decision SLA, stamped at claim time (services/audit-lifecycle.ts
  // reaper scans this).
  claimExpiresAt        DateTime?                    @map("claim_expires_at")
  // The claimable batch this window's selected items belong to, 1:1.
  //
  // The window is the SAMPLING record (eligible/quota/HMAC selection) and,
  // in this deployment, also the claimable unit — `community.human_audit_window_size`
  // is documented as "the batch a validator claims. 50-100 (owner requirement)"
  // and pool-lifecycle already packs selected items into chunks of that size.
  // So a batch is created per chunk rather than pooled independently: two
  // batching layers with different sizes (windows of 50, v1's audit batches of
  // 25) would each claim to be "the unit a validator claims".
  //
  // Nullable because every window created before this alignment has no batch,
  // and because a window with zero selected items needs none.
  auditBatchId          String?                      @unique @map("audit_batch_id")
  auditBatch            AuditBatch?                  @relation(fields: [auditBatchId], references: [id], onDelete: SetNull)
  bounty                Bounty                       @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  claimedBy             User?                        @relation("HumanAuditWindowClaimant", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  memberships           HumanAuditWindowMembership[]

  @@unique([bountyId, windowIndex])
  @@index([bountyId, closedAt])
  @@index([bountyId, supersededAt])
  // Created by 20260811100000_add_community_audit_window_quality_policy but
  // never declared here, so `migrate diff` reported permanent drift on every
  // environment. Pinned with an explicit map to the name that migration
  // already created — declaring it without the map would make Prisma want to
  // drop and recreate a live index for a naming difference alone.
  @@index([bountyId, settledAt], map: "human_audit_windows_bounty_id_settled_at_idx")
  // Reaper scan: overdue open claims.
  @@index([claimExpiresAt])
  // "My open audits" / capacity checks.
  @@index([claimedByUserId, settledAt])
  @@map("human_audit_windows")
}

model HumanAuditWindowMembership {
  id           String           @id @default(cuid())
  windowId     String           @map("window_id")
  submissionId String           @map("submission_id")
  selected     Boolean          @default(false)
  rank         String
  window       HumanAuditWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([windowId, submissionId])
  @@unique([windowId, rank])
  @@index([submissionId])
  @@map("human_audit_window_memberships")
}

model DatasetRequest {
  id               String               @id @default(cuid())
  requesterUserId  String               @map("requester_user_id")
  title            String
  description      String
  datasetTypeId    String?              @map("dataset_type_id")
  domain           DomainId?
  proposedLicense  String               @map("proposed_license")
  // Scope the requester specifies up front so an admin has everything needed
  // to accept and mint without a follow-up conversation. Nullable because
  // requests filed before the planner collected them still have to load; the
  // API requires all of them on every new request.
  language         String?
  framework        String?
  targetItems      Int?                 @map("target_items")
  // One of the planner's difficulty presets (mostly_beginner | balanced |
  // mostly_advanced) — spread across the dataset type's own difficulty levels
  // at mint time by deriveSlots(), same as a supported bounty.
  difficultyMix    String?              @map("difficulty_mix")
  auditCoveragePct Int?                 @map("audit_coverage_pct")
  idempotencyKey   String               @map("idempotency_key")
  status           DatasetRequestStatus @default(submitted)
  adminNote        String?              @map("admin_note")
  // Uncapped review loop (plan G1): count of times the requester resubmitted
  // after a changes_requested. Not a hard cap — anti-abuse is rate-limiting.
  resubmitCount    Int                  @default(0) @map("resubmit_count")
  reviewedBy       String?              @map("reviewed_by")
  reviewedAt       DateTime?            @map("reviewed_at")
  mintedBountyId   String?              @unique @map("minted_bounty_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  artifacts    Artifact[]
  requester    User                    @relation("DatasetRequestRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  datasetType  DatasetType?            @relation(fields: [datasetTypeId], references: [id])
  mintedBounty Bounty?                 @relation("CommunityRequestBounty", fields: [mintedBountyId], references: [id])
  comments     DatasetRequestComment[]

  @@unique([requesterUserId, idempotencyKey])
  @@index([status, createdAt])
  @@index([requesterUserId, createdAt])
  @@map("dataset_requests")
}

model DatasetRequestComment {
  id           String   @id @default(cuid())
  requestId    String   @map("request_id")
  authorUserId String   @map("author_user_id")
  authorRole   String   @map("author_role")
  body         String
  internalOnly Boolean  @default(false) @map("internal_only")
  createdAt    DateTime @default(now()) @map("created_at")

  request DatasetRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("dataset_request_comments")
}

enum AgentIssueStatus {
  received
  triaged
  investigating
  needs_info
  duplicate
  not_reproducible
  resolved
  rejected
}

enum AgentIssueCategory {
  contract
  validation
  mcp
  upload_processing
  data_quality
  security_privacy
  abuse
  other
}

enum AgentIssueImpact {
  blocked
  degraded
  suggestion
}

enum AgentIssueSeverity {
  low
  medium
  high
  critical
}

model AgentIssue {
  id String @id @default(cuid())

  // Nullable so an erased account tombstones its cases instead of cascading
  // them away: the case body and timeline survive for operational history,
  // the human behind it does not. `reporterLabel` keeps a non-identifying
  // stand-in ("agent-4f3c") for a queue that would otherwise show a blank.
  reporterUserId String? @map("reporter_user_id")
  reporterLabel  String  @map("reporter_label")
  // How the report arrived — "mcp_oauth" | "api_key" | "session". Stored as
  // text (not the ApiKeyScope/credential enums) because it is descriptive
  // provenance, not an authorization input.
  source         String
  // Opaque credential id when one was presented. Never the key, never a hash
  // that could be replayed — only enough to correlate a misbehaving agent.
  credentialRef  String? @map("credential_ref")
  clientName     String? @map("client_name")
  toolName       String? @map("tool_name")
  requestId      String? @map("request_id")

  category AgentIssueCategory
  impact   AgentIssueImpact
  severity AgentIssueSeverity?
  status   AgentIssueStatus    @default(received)

  summary    String
  expected   String
  actual     String
  steps      String?
  // Caller-supplied excerpt AFTER RedactionPolicy. Bounded in the service; the
  // raw value is never persisted, indexed, fingerprinted, or notified.
  logExcerpt String? @map("log_excerpt")

  // Server-collected, allowlisted projection of the resources the caller named
  // AND is authorized to see (ids/status/version/error code only — never
  // artifact bytes or item contents). Snapshot, not a live permission grant.
  context           Json?
  // "complete" | "partial" | "pending" | "unavailable". Written ONLY from
  // `contextCollectionFor()` (services/issues.ts), which reserves "complete"
  // for "every named resource resolved AND authorized".
  //
  // The default is "unavailable" and must stay that way. It used to be
  // "complete", which meant a row inserted without an explicit value — i.e.
  // every case, since nothing wrote the column — claimed a full context
  // snapshot that had never been taken, and the web rendered a green
  // "Context attached" pill directly above "No resources were named on this
  // case." A default that asserts a check passed is the exact failure mode the
  // trust-honesty invariant forbids; "unavailable" is the honest floor.
  contextCollection String  @default("unavailable") @map("context_collection")
  redactionApplied  Boolean @default(false) @map("redaction_applied")

  // Deterministic dedupe candidate key (category + resource tuple + summary
  // hash). ADVISORY ONLY — suggestions for staff. Nothing auto-merges or
  // auto-closes on a fingerprint match.
  fingerprint String

  canonicalIssueId String? @map("canonical_issue_id")
  assignedToUserId String? @map("assigned_to_user_id")

  resolutionNote String?   @map("resolution_note")
  // Free-text deploy/PR/bug reference for now; a typed integration is a
  // deliberate later decision, not an implied one.
  resolutionRef  String?   @map("resolution_ref")
  resolvedAt     DateTime? @map("resolved_at")

  // Optimistic concurrency for every staff command. Two admins on one detail
  // page must not last-write-wins each other's disposition.
  version        Int    @default(1)
  idempotencyKey String @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reporter   User?             @relation("AgentIssueReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  assignedTo User?             @relation("AgentIssueAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  canonical  AgentIssue?       @relation("AgentIssueDuplicates", fields: [canonicalIssueId], references: [id])
  duplicates AgentIssue[]      @relation("AgentIssueDuplicates")
  events     AgentIssueEvent[]

  @@unique([reporterUserId, idempotencyKey])
  @@index([status, createdAt])
  @@index([reporterUserId, createdAt])
  @@index([fingerprint, createdAt])
  @@index([canonicalIssueId])
  @@index([assignedToUserId, status])
  @@map("agent_issues")
}

model AgentIssueEvent {
  id      String @id @default(cuid())
  issueId String @map("issue_id")

  // No FK on the actor on purpose (same choice as DatasetRequestComment):
  // history must outlive the account, and a SetNull here would erase who acted.
  actorUserId  String? @map("actor_user_id")
  actorRole    String  @map("actor_role")
  // created | reporter_reply | status_changed | assigned | info_requested |
  // merged | unmerged | resolved | note | job_health | enriched | escalated
  // (`enriched` and `escalated` are written by workers and are internalOnly:
  // an enrichment result and an aging alert are facts about staff's queue, not
  // news for the reporter.)
  type         String
  body         String?
  internalOnly Boolean @default(false) @map("internal_only")
  metadata     Json?
  requestId    String? @map("request_id")

  createdAt DateTime @default(now()) @map("created_at")

  issue AgentIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
  @@map("agent_issue_events")
}

model KarmaEvent {
  id         String         @id @default(cuid())
  userId     String         @map("user_id")
  eventType  KarmaEventType @map("event_type")
  amount     Int
  sourceType String         @map("source_type")
  sourceId   String         @map("source_id")
  metadata   Json?
  createdAt  DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, eventType, sourceType, sourceId])
  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
  @@map("karma_events")
}

model PendingKarmaAward {
  id             String         @id @default(cuid())
  bountyId       String         @map("bounty_id")
  userId         String         @map("user_id")
  eventType      KarmaEventType @map("event_type")
  amount         Int
  sourceType     String         @map("source_type")
  sourceId       String         @map("source_id")
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at")
  releasedAt     DateTime?      @map("released_at")
  // Set when the underlying acceptance is undone (upheld dispute, terminal
  // rejection) before publication ever released it. A row can be released
  // XOR reversed, never both — awardPublicationKarma must skip any row with
  // this set, the same way it always skipped an already-released one.
  reversedAt     DateTime?      @map("reversed_at")
  reversedReason String?        @map("reversed_reason")

  bounty Bounty @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, eventType, sourceType, sourceId])
  @@index([bountyId, releasedAt])
  @@map("pending_karma_awards")
}

model Badge {
  id          String      @id @default(cuid())
  // Stable identifier the frontends key off. Immutable once created so that
  // renaming a badge's label never orphans awards or icon handling.
  key         String      @unique
  family      BadgeFamily
  label       String
  // Human-readable statement of what earns it. Shown verbatim to members.
  criteria    String
  icon        BadgeIcon
  metric      BadgeMetric
  threshold   Int         @default(1)
  // Minimum sample size before a ratio-based metric may award, so a member
  // with 1-for-1 confirmed flags does not earn a "95% accuracy" badge.
  minSample   Int         @default(0) @map("min_sample")
  // False for `manual` badges: the console grants them explicitly.
  autoGranted Boolean     @default(true) @map("auto_granted")
  // Deactivated badges stop being awarded and disappear from the member
  // dashboard, but existing awards are retained for history.
  active      Boolean     @default(true)
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  awards UserBadge[]

  @@index([active, family, sortOrder])
  @@map("badges")
}

model UserBadge {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  badgeId         String   @map("badge_id")
  earnedAt        DateTime @default(now()) @map("earned_at")
  // Set only for manually granted badges; null means the evaluator awarded it.
  grantedByUserId String?  @map("granted_by_user_id")
  // The measured value at the moment of the award, kept as evidence so the
  // dashboard can render "214 accepted items" without recomputing history.
  measuredValue   Int?     @map("measured_value")

  user      User  @relation("BadgeHolder", fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("BadgeGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, badgeId])
