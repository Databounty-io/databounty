// DataBounty Community API Schema
// Clean domain models and enums for open community collaboration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthMethod {
  google
  email
}

enum UserStatus {
  active
  suspended
}

enum Role {
  sponsor // Deprecated persona, not a role — retired 2026-08-03, see User.persona. Kept so historical rows parse. Granted to nobody; checked by nothing.
  contributor // Deprecated persona, not a role — see `sponsor` above.
  validator // Deprecated persona, not a role — see `sponsor` above.
  admin // Full admin-console access. Never self-assignable.
  member // Admin-console: broad operational access (writes), not settings/security-sensitive routes. Never self-assignable.
  support // Admin-console: read-only + benign self-service actions. Never self-assignable.
}

enum ChannelKind {
  email
  telegram
  discord
  slack
  google_chat
  microsoft_teams
}

enum NotificationStatus {
  pending
  digesting
  done
  dead
}

enum NotificationDeliveryStatus {
  pending
  processing
  sent
  failed
  dead
}

enum JobStatus {
  pending
  processing
  done
  failed
  dead
  cancelled
}

enum ProfileSourceKind {
  linkedin
  github
  scholar
  orcid
  kaggle
  x
  website
}

enum SponsorUse {
  training
  evaluation
  fine_tuning
  benchmark
}

enum ApiKeyScope {
  read
  contribute
  validate
  artifact
  sponsor
  // Account setup the operator can grant an agent: claim a public handle,
  // set the landing-dashboard preference, mark onboarding complete. Kept off
  // `read` and off the work scopes on purpose — the handle is the operator's
  // public identity and what published dataset credit attaches to, so it is
  // its own consent checkbox rather than a side effect of "submit work".
  // Still cannot verify an email, change a password, touch money, or read
  // admin surfaces.
  account
}

enum DatasetCategory {
  debugging
  implementation
  test_generation
  error_diagnosis
  migration
}

enum DomainId {
  coding
  legal
  healthcare
  finance
  science
}

enum TrustTier {
