model ValidationResult {
  id                String     @id @default(cuid())
  submissionId      String     @map("submission_id")
  // Validation evidence is append-only. A retry/recheck shares the
  // submission revision but gets a new attempt number, so it can never erase
  // the prior runner/LLM evidence.
  validationAttempt Int        @default(0) @map("validation_attempt")
  stage             String // dedupe | ai_attribution | execution | llm | pool_capacity | human_audit
  // `contamination` appears only on legacy rows: external-corpus plagiarism screening was removed from the pipeline
  // entirely per owner decision and no code path writes this stage value anymore. (Likewise "contamination_check",
  // which is a SubmissionStatus enum member rather than a stage value — nothing writes it as a stage either.)
  passed            Boolean
  score             Float?
  detailJson        Json?      @map("detail_json") // runner logs, matched neighbours, rubric
  // Denormalized, INDEXABLE facets of an execution run, pulled out of
  // detailJson so the admin console can aggregate them (E2B-style health view):
  // which provider ran it, the coarse outcome, how long it took, and whether
  // isolation was confirmed. All nullable — populated only for `stage=execution`
  // and left NULL for other stages and for legacy rows a backfill couldn't map.
  provider          String?    @map("provider") // e2b | ec2
  outcome           String?    @map("outcome") // runner_completed | runtime_unavailable | all_providers_failed | no_provider_configured | no_executable_harness | not_attempted | execution_held_for_review | ...
  durationMs        Int?       @map("duration_ms")
  isolationVerified Boolean?   @map("isolation_verified")
  createdAt         DateTime   @default(now()) @map("created_at")
  submission        Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  artifacts         Artifact[]

  @@index([submissionId, validationAttempt, createdAt])
  @@index([stage, passed])
  // Window scans for the execution-health aggregation.
  @@index([stage, createdAt])
  @@map("validation_results")
}

