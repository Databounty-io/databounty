  eventKey     String                 @map("event_key")
  entityType   String?                @map("entity_type")
  entityId     String?                @map("entity_id")
  /// Bounty id for building an audience-specific deep link when entityId
  /// points at a batch/audit rather than the bounty itself (see
  /// notificationHref in services/notifications.ts).
  linkBountyId String?                @map("link_bounty_id")
  /// Structured render payload for notifications whose content is a
  /// COLLECTION rather than one event — today only `digest.summary`, which
  /// stores a `DigestPayload` (see services/notifications/digest.ts) so the
  /// email adapter can render per-section counts and one link per line instead
  /// of a flat string. Null for every ordinary event, whose title/body already
  /// say everything. Never holds secrets: it is rendered into outbound mail.
  data         Json?
  read         Boolean                @default(false)
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
