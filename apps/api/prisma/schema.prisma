  llm_verified
  expert_audited
}

enum DatasetTypeStatus {
  active
  draft
  coming_soon
  platform_review
}

enum DatasetTypeOrigin {
  platform
  sponsor
}

enum AuditMode {
  llm_only
  partial
  full
}

enum GenerationMethod {
  human
  ai_assisted
  ai_generated
}

enum BountyStatus {
  draft
  planning
  platform_review
  active
  paused
  closing
  export_ready
  completed
  partially_completed
  cancelled
  disputed
}

enum BountyKind {
  community
}

enum DatasetRequestStatus {
  submitted
  under_review
  changes_requested
  approved
  declined
  disputed
  implemented
}

enum CommunityPublicationStatus {
  not_requested
  pending
  publishing
  published
  failed
  manual_review
  // An admin withdrew an already-published dataset: public access has been
  // removed at the provider and confirmed before this state is recorded.
  // Distinct from `failed` (the push itself never succeeded).
  retracted
  // Per-target only (DatasetPublication.status). The target is enabled but its
  // credential/namespace is missing, so nothing was attempted. Distinct from
  // `failed`, which means a real attempt did not succeed — conflating the two
  // would put a config gap into the operator's retry queue forever.
  not_configured
  // Per-target only, and only for an `assisted_manual` target: the bundle is
  // built and downloadable, and the platform is waiting on a human to complete
  // the portal upload and record the URL. Never rendered as published.
  awaiting_manual_upload
}

enum PublicationTarget {
  huggingface
  github
  aikosh
}

enum KarmaEventType {
  community_item_accepted
  community_item_reversed
  community_audit_completed
  community_request_approved
  community_bounty_published
  community_flag_confirmed
  community_publish_bonus
  admin_adjustment
}

enum BadgeMetric {
  verified_credentials
  accepted_items
  clean_delivery_streak
  completed_audits
  confirmed_flags
  karma_total
  // Community programs the member has accepted work in that reached
  // publication status `published`.
  published_datasets
  // Percentage of the member's decided flags the platform confirmed.
  // `threshold` is the percentage; `minSample` is the minimum decided flags
  // required before the ratio is trustworthy enough to award on.
  flag_accuracy_pct
  // Position on the all-time open leaderboard. Compared inverted: a rank at or
  // below `threshold` qualifies (threshold 10 = "top 10").
  leaderboard_rank
  // `threshold` is the minimum accepted items required before a spotless
  // record counts — a contributor with zero work has not "avoided" anything.
  zero_abandons
  // `threshold` is the minimum decided flags required before a spotless
  // flag record counts.
  zero_dismissed_flags
  // Nothing is measured: the badge exists only to be granted by an admin.
  manual
}

enum BadgeFamily {
  build
  audit
  platform
}

enum BadgeIcon {
  check
  code
  shield
  clock
  eye
  award
  flag
  sparkles
  zap
  users
  database
  layers
  coins
  beaker
}

enum SubmissionStatus {
  draft
  submitted
  duplicate_check
  // DEPRECATED / unused: external-corpus plagiarism screening was removed
  // from the pipeline entirely per owner decision (services/validation.ts
  // never transitions a submission to this status). Kept in the enum rather
  // than dropped — an enum-value drop is a schema migration this cleanup
  // does not make; no live row currently holds this status.
  contamination_check
  running_tests
  tests_failed
  llm_validation
  needs_fixes
  provisionally_accepted
  in_audit
  // Community open-pool with NO validators (auditCoveragePct == 0),
  // COMMUNITY_OPEN_POOL_PLAN_V2 §3.3c ("Piece 2"): at pool close-out every
  // item is routed here for the sponsor/requester to approve or reject, in
  // place of validator review. Sponsor approve -> `accepted`; sponsor reject
  // -> `needs_fixes` (contributor revises). Held (reserves a pool slot) until
  // the sponsor decides; nothing publishes until every item is resolved.
  in_sponsor_review
  flagged
  disputed
  accepted
  // Community open-pool only (COMMUNITY_OPEN_POOL_PLAN_V2 §3.3): a clean pass
  // through the automated pipeline lands here instead of `accepted` while the
  // pool is still open. `schedulePoolSampling` resolves every row in this
  // status to either `in_audit` (sampled) or `accepted` (not sampled) at pool
  // close-out. Never a terminal state on its own.
  accepted_pending_sample
  rejected
}

enum ContributorBatchStatus {
  available
  claimed
  submitted
  needs_fixes
  partially_accepted
  accepted
  abandoned
}

enum FlagReason {
  duplicate
  // DEPRECATED / unused: external-corpus plagiarism screening was removed
  // from the pipeline entirely per owner decision; no code path creates a
  // Flag with this reason and no live row currently holds it. Kept in the
  // enum rather than dropped — an enum-value drop is a schema migration
  // this cleanup does not make.
  contaminated
  tests_invalid
  solution_incorrect
  too_trivial
  low_quality
  off_spec
  // Escape hatch for a real problem none of the fixed reasons name. Safe only
  // because a rejecting decision already requires a written note
  // (lib/audit-decision-note.ts) — without that, "other" would be a rejection
  // with no stated cause at all.
  other
}

enum FlagStatus {
  open
  fixed
  disputed
  confirmed
  dismissed
}

enum AuditVerdict {
  ok
  flagged
}

enum SponsorExampleReviewStatus {
  pending
  approved
  needs_changes
  rejected
}

enum DisputeStatus {
  open
  resolved
}

enum ArtifactKind {
  sponsor_reference // sponsor creation-time examples: samples, starter files, rubric notes
  submission_attachment // contributor per-item files, code bundles, fixtures
  bulk_submission_source // original uploaded JSON/CSV/JSONL source for a batch
  validation_log // sandbox stdout/stderr, runner traces
  validation_report // aggregated dedupe/execution/llm report
  export_bundle // final JSONL/CSV/ZIP + manifest for the sponsor
  public_sample // limited public marketplace preview
  benchmark_manifest // frozen public benchmark manifest
  benchmark_private_split // held-out benchmark inputs/tests; never public
  benchmark_run_output // bounded per-task evaluator output/evidence
  publication_bundle // portal-ready archive for an assisted-manual publication target
}

enum ArtifactVisibility {
  private // owner + admins only
  work_brief // readable by contributors/validators working the bounty
  accepted_delivery // readable by the sponsor after acceptance
  public_sample // world-readable marketplace preview
}

enum ArtifactStatus {
  pending_upload // slot issued, bytes not yet stored
  scanning // stored, awaiting virus/content scan
  ready // stored and cleared for read
  quarantined // failed scan or size/checksum mismatch
  deleted // soft-deleted
}

enum BulkParseStatus {
  not_applicable // artifact kind isn't bulk_submission_source
  skipped // uploaded as the source of record for items submitted another way — deliberately never ingested
  pending // ready, job enqueued but not yet started
  processing // worker has committed at least one chunk
  done // fully parsed, all rows accounted for
  failed // job exhausted retries; see bulkParseError
}

enum ArtifactModality {
  image
  video
  audio
  document // pdf, docx, etc.
  archive // zip and friends
  code
  text
  other
}

enum ArtifactScanStatus {
  not_required
  pending
  clean
  infected
  error
  /// Declared MIME/extension doesn't match the file's actual byte signature
  /// (magic-byte check, §2.5) — distinct from `infected` (malware scanner
  /// verdict) so admin evidence doesn't conflate "scanned, found malware"
  /// with "the declaration itself was dishonest."
  content_mismatch
}

enum BenchmarkStatus {
  draft
  published
  archived
}

enum BenchmarkVersionStatus {
  draft
  building
  validating
  ready
  published
  failed
  archived
}

enum BenchmarkTaskSplit {
  public_sample
  private_holdout
}

enum BenchmarkRunStatus {
  pending
  running
  completed
  failed
  cancelled
}

enum BenchmarkTaskResultStatus {
  pending
  running
  passed
  failed
  errored
  skipped
  cancelled
}

model User {
  id                     String     @id @default(cuid())
  authMethod             AuthMethod @map("auth_method")
  email                  String?    @unique
  googleId               String?    @unique @map("google_id")
  passwordHash           String?    @map("password_hash")
  displayName            String     @map("display_name")
  // Canonical lowercase public identifier. Nullable so every pre-launch
  // account remains valid until its owner explicitly claims a handle.
  handle                 String?    @unique
  status                 UserStatus @default(active)
  onboarded              Boolean    @default(false)
  // Which dashboard this user prefers to land on: "sponsor" | "contributor" |
  // "validator" (see lib/persona.ts). A UI preference ONLY — it grants no
  // capability and no route may gate on it. Nullable because a user may
  // onboard without choosing, or clear the choice later.
  persona                String?
  profilePublic          Boolean    @default(false) @map("profile_public")
  // Maintained running sum of the member's karma_events.amount, kept in step
  // by awardKarma / reverseAcceptedSubmissionKarma inside the same transaction
  // as the event write. Denormalized so the Open-leaderboard rank is an
  // indexed COUNT over users (WHERE karma_total > $x) instead of a full
  // GROUP BY aggregate of the whole karma_events table on every profile load.
  karmaTotal             Int        @default(0) @map("karma_total")
  // Last OBSERVED Open-leaderboard position, and when it was observed. Written
  // only by the `leaderboard.rank_check` job (services/leaderboard-movement.ts)
  // after a karma event changed this member's balance — never computed on a read
  // path, so a surface can only ever report a position the platform actually
  // recorded. Null means "not on the leaderboard" (private profile, karma
  // visibility off, or a zero balance), which is a real answer and must render
  // as such rather than as rank 0.
  leaderboardRank        Int?       @map("leaderboard_rank")
  leaderboardRankAt      DateTime?  @map("leaderboard_rank_at")
  // The position held BEFORE the most recent improvement, and when that
  // improvement was recorded. These are what let a surface say "you were #14 on
  // 14 Aug, you are #11 now" without recomputing history. Only an improvement
  // writes them: a rank that worsened (someone overtook this member, or their
  // own award was reversed) updates `leaderboardRank` and deliberately leaves
  // these alone, because the platform reports gains and never taunts a member
  // with a loss. `leaderboardRankPrev` is therefore not "the previous value of
  // leaderboardRank" in general — it is the baseline of the last reported gain.
  leaderboardRankPrev    Int?       @map("leaderboard_rank_prev")
  leaderboardRankMovedAt DateTime?  @map("leaderboard_rank_moved_at")
  // Public-profile field controls. The public endpoint uses an explicit
  // allowlist and never serializes profile-source/credential data directly.
  publicProfilePrefs     Json?      @map("public_profile_prefs")
  // Google accounts are considered verified at creation (Google already
  // verified the address) — this is only ever null for an email/password
  // signup that hasn't clicked its verification link yet.
  emailVerifiedAt        DateTime?  @map("email_verified_at")
  // Bumped on logout (see routes/v1/auth.ts's /logout) and intended to be
  // bumped on any future disablement/role-change action, invalidating
  // anything issued against an earlier value. (Previously also compared by
  // the cross-service enterprise-assertion bridge, removed 2026-09-03 per
  // D21 — Enterprise is retired, so that comparison no longer exists.)
  revocationVersion      Int        @default(0) @map("revocation_version")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")
  lastSeenAt             DateTime?  @map("last_seen_at")

  roles                       UserRole[]
  sessions                    Session[]
  oauthClientsOwned           OAuthClient[]               @relation("OAuthClientOwner")
  oauthAuthorizationRequests  OAuthAuthorizationRequest[]
  oauthAuthorizationCodes     OAuthAuthorizationCode[]
  oauthAccessTokens           OAuthAccessToken[]
  oauthRefreshTokens          OAuthRefreshToken[]
  oauthAuditEvents            OAuthAuditEvent[]
  passwordResetTokens         PasswordResetToken[]
  emailVerificationTokens     EmailVerificationToken[]
  channels                    NotificationChannel[]
  telegramLink                TelegramLink?
  watchPref                   WatchPref?
  profileSources              ProfileSource[]
  sponsorScope                SponsorScope?
  apiKeys                     ApiKey[]
  bounties                    Bounty[]                    @relation("SponsorBounties")
  batches                     ContributorBatch[]
  submissions                 Submission[]
  disputes                    Dispute[]
  rank                        Rank?
  waitlistEntries             WaitlistEntry[]
  notifications               Notification[]
  datasetTypes                DatasetType[]               @relation("AuthoredTypes")
  authoredHarnesses           DatasetTypeHarness[]        @relation("AuthoredHarnesses")
  adminInvitesSent            AdminInvite[]               @relation("AdminInvitesSent")
  workspaceMemberships        WorkspaceMember[]
  ownedWorkspaces             Workspace[]                 @relation("OwnedWorkspaces")
  artifacts                   Artifact[]
  adminAuditLogs              AdminAuditLog[]
  datasetRequests             DatasetRequest[]            @relation("DatasetRequestRequester")
  communityBounties           Bounty[]                    @relation("CommunityBountyRequester")
  karmaEvents                 KarmaEvent[]
  pendingKarmaAwards          PendingKarmaAward[]
  badges                      UserBadge[]                 @relation("BadgeHolder")
  badgesGranted               UserBadge[]                 @relation("BadgeGrantedBy")
  benchmarksCreated           Benchmark[]                 @relation("BenchmarkCreatedBy")
  benchmarkVersionsCreated    BenchmarkVersion[]          @relation("BenchmarkVersionCreatedBy")
  benchmarkVersionsApproved   BenchmarkVersion[]          @relation("BenchmarkVersionApprovedBy")
  benchmarkRunsRequested      BenchmarkRun[]              @relation("BenchmarkRunRequestedBy")
  uploadReviewDrafts          SubmissionUploadDraft[]
  agentIssuesReported         AgentIssue[]                @relation("AgentIssueReporter")
  agentIssuesAssigned         AgentIssue[]                @relation("AgentIssueAssignee")
  datasetPublicationsAttested DatasetPublication[]        @relation("DatasetPublicationPublisher")
  claimedAuditWindows         HumanAuditWindow[]          @relation("HumanAuditWindowClaimant")
  auditBatches                AuditBatch[]

  // Open-leaderboard rank: count public, handle-claimed, karma-visible users
  // with a higher karma_total. This composite covers that predicate + range.
  @@index([profilePublic, handle, karmaTotal])
  @@map("users")
}

model UserRole {
  userId String @map("user_id")
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

enum WorkspaceKind {
  personal
  team
}

enum WorkspaceRole {
  owner
  admin
  member
}

model Workspace {
  id        String        @id @default(cuid())
  name      String
  kind      WorkspaceKind @default(personal)
  // Deleting the owner deletes the workspace (cascade) — right for personal
  // workspaces and structurally prevents orphaned rows. When team
  // workspaces become real, the user-deletion flow must transfer ownership
  // before removing an owner account, rather than letting the cascade take
  // the whole team workspace down.
  ownerId   String        @map("owner_id")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  owner   User              @relation("OwnedWorkspaces", fields: [ownerId], references: [id], onDelete: Cascade)
  members WorkspaceMember[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(owner)
  createdAt   DateTime      @default(now()) @map("created_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model AdminInvite {
  id          String    @id @default(cuid())
  email       String
  role        Role
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  invitedBy   User      @relation("AdminInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("admin_invites")
}

model AuthNonce {
  id        String    @id @default(cuid())
  nonce     String    @unique
  message   String?
  usedAt    DateTime? @map("used_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("auth_nonces")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  userAgent String?  @map("user_agent")
  ip        String?
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model OAuthClient {
  id                      String                      @id @default(cuid())
  clientId                String                      @unique @map("client_id")
  clientSecretHash        String?                     @map("client_secret_hash")
  clientName              String?                     @map("client_name")
  redirectUris            String[]                    @map("redirect_uris")
  grantTypes              String[]                    @default(["authorization_code", "refresh_token"]) @map("grant_types")
  tokenEndpointAuthMethod String                      @default("none") @map("token_endpoint_auth_method")
  ownerUserId             String?                     @map("owner_user_id")
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")
  owner                   User?                       @relation("OAuthClientOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  authorizationRequests   OAuthAuthorizationRequest[]
  authorizationCodes      OAuthAuthorizationCode[]
  accessTokens            OAuthAccessToken[]
  refreshTokens           OAuthRefreshToken[]
  auditEvents             OAuthAuditEvent[]

  @@index([ownerUserId])
  @@map("oauth_clients")
}

model OAuthAuthorizationRequest {
  id            String      @id @default(cuid())
  clientId      String      @map("client_id")
  userId        String?     @map("user_id")
  redirectUri   String      @map("redirect_uri")
  scope         String[]
  state         String?
  codeChallenge String      @map("code_challenge")
  resource      String?
  expiresAt     DateTime    @map("expires_at")
  approvedAt    DateTime?   @map("approved_at")
  deniedAt      DateTime?   @map("denied_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  client        OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clientId, expiresAt])
  @@index([userId, expiresAt])
  @@map("oauth_authorization_requests")
}

model OAuthAuthorizationCode {
  id            String              @id @default(cuid())
  codeHash      String              @unique @map("code_hash")
  clientId      String              @map("client_id")
  userId        String              @map("user_id")
  redirectUri   String              @map("redirect_uri")
  scope         String[]
  codeChallenge String              @map("code_challenge")
  resource      String?
  expiresAt     DateTime            @map("expires_at")
  usedAt        DateTime?           @map("used_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  client        OAuthClient         @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens  OAuthAccessToken[]
  refreshTokens OAuthRefreshToken[]

  @@index([clientId, expiresAt])
  @@map("oauth_authorization_codes")
}

model OAuthAccessToken {
  id                  String                  @id @default(cuid())
  tokenHash           String                  @unique @map("token_hash")
  clientId            String                  @map("client_id")
  userId              String                  @map("user_id")
  scope               String[]
  resource            String?
  expiresAt           DateTime                @map("expires_at")
  revokedAt           DateTime?               @map("revoked_at")
  createdAt           DateTime                @default(now()) @map("created_at")
  /// Traces this token back to the authorization code that minted it — null
  /// for a token issued by refresh (exchangeRefreshToken never has a code)
  /// and for every token that predates this column. Exists so a REPLAYED
  /// code (OAuth 2.1 4.1.3 / 7.5.3: a code presented again after it was
  /// already consumed) can revoke exactly the tokens it produced. `SetNull`
  /// on the code's deletion, never `Restrict`/`Cascade`: cleanupMcpOAuth's
  /// sweep must be free to delete the code row once the tokens it names have
  /// gone their own way, and it must never delete a LIVE access token as a
  /// side effect of pruning the code that once minted it.
  authorizationCodeId String?                 @map("authorization_code_id")
  client              OAuthClient             @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorizationCode   OAuthAuthorizationCode? @relation(fields: [authorizationCodeId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([clientId, expiresAt])
  @@index([authorizationCodeId])
  @@map("oauth_access_tokens")
}

model OAuthRefreshToken {
  id                  String                  @id @default(cuid())
  tokenHash           String                  @unique @map("token_hash")
  clientId            String                  @map("client_id")
  userId              String                  @map("user_id")
  scope               String[]
  resource            String?
  expiresAt           DateTime                @map("expires_at")
  revokedAt           DateTime?               @map("revoked_at")
  /// Set ONLY when this token was retired by a successful rotation, alongside
  /// `revokedAt`. Explicit revocation (RFC 7009, dashboard disconnect, account
  /// suspension) sets `revokedAt` and leaves this null, which is what keeps the
  /// short reuse grace window in exchangeRefreshToken from ever resurrecting a
  /// grant the user deliberately killed.
  rotatedAt           DateTime?               @map("rotated_at")
  createdAt           DateTime                @default(now()) @map("created_at")
  /// Same rationale as OAuthAccessToken.authorizationCodeId — see there.
  authorizationCodeId String?                 @map("authorization_code_id")
  client              OAuthClient             @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorizationCode   OAuthAuthorizationCode? @relation(fields: [authorizationCodeId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([clientId, expiresAt])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_tokens")
}

model OAuthAuditEvent {
  id        String       @id @default(cuid())
  action    String
  clientId  String?      @map("client_id")
  userId    String?      @map("user_id")
  metadata  Json?
  ip        String?
  userAgent String?      @map("user_agent")
  createdAt DateTime     @default(now()) @map("created_at")
  client    OAuthClient? @relation(fields: [clientId], references: [clientId], onDelete: SetNull)
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([userId, createdAt])
  @@map("oauth_audit_events")
}

enum PasswordTokenPurpose {
  reset
