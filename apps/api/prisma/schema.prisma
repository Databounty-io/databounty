  status            ContributorBatchStatus @default(available)
  deadline          DateTime?
  claimedAt         DateTime?              @map("claimed_at")
  createdAt         DateTime               @default(now()) @map("created_at")

  bounty             Bounty                  @relation(fields: [bountyId], references: [id], onDelete: Cascade, map: "creator_batches_bounty_id_fkey")
  batchPlan          BountyBatchPlan?        @relation(fields: [batchPlanId], references: [id], onDelete: SetNull, map: "creator_batches_batch_plan_id_fkey")
  workShard          BountyWorkShard?        @relation(fields: [workShardId], references: [id], onDelete: SetNull, map: "creator_batches_work_shard_id_fkey")
