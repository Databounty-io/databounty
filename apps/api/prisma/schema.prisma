model DatasetType {
  id                 String               @id // slug, e.g. "sql_generation"
  familyId           String               @default(cuid()) @map("family_id")
  supersedesId       String?              @unique @map("supersedes_id")
  version            Int                  @default(1)
  domain             DomainId
  name               String
  description        String
  status             DatasetTypeStatus
  origin             DatasetTypeOrigin
  category           DatasetCategory // nearest legacy category for filters
  trustTier          TrustTier            @map("trust_tier")
  fields             Json // TypeField[]
  verification       Json // { pipeline, executionEnv, dedupeFields, auditOptions }
  // Optional curated example item(s) shown on the template card, HF-style:
  // { fields?: Record<key,string>, media?: {key,url,kind,alt?}[], caption? }[].
  // Nullable and empty by default — a card renders an explicit "no sample yet"
  // state rather than a placeholder that implies real data. Real, licence-
  // cleared samples are populated by an admin; never fabricated.
  sampleAssets       Json?                @map("sample_assets")
  // Karma pricing axes (KARMA_PRICING_MATRIX_PLAN.md §2). `complexityScore` is
  // 1–4: what it takes to verify an item of this type is correct, admin-assigned
  // and domain-neutral. `verificationUnits` counts the fields of this template
  // that undergo automated, machine-run verification, which buckets into the
  // verification band. Both are NULLABLE and null means *unpriced* — never a
  // default: an unpriced type must fail closed rather than quietly price at a
  // middle score (plan G-9 / OD-6). Seeded for the 33 registry categories from
  // lib/karma-category-scores.ts; legacy, non-coding, and sponsor fork/custom
  // types start null and are priced by an admin at review.
  complexityScore    Int?                 @map("complexity_score")
  verificationUnits  Int?                 @map("verification_units")
  // The admin's note from the most recent platform-review decision on a
  // sponsor-submitted (fork/custom) type — required on a decline so the
  // sponsor sees why, optional on an approval. Overwritten per decision, not
  // an audit trail (writeAuditLog already records who/when).
  reviewNote         String?              @map("review_note")
  // The sponsor's own request for sandboxed execution verification, written
  // at fork/custom creation time (sponsor/create planner "fields" step) —
  // plain-text description of what the harness should check, NEVER
  // executable code. Purely informational: it is surfaced to an admin
  // reviewing this type so they can decide whether to author a real harness
  // via the existing ADMIN-ONLY `admin-harness.ts` flow. Nothing in this
  // column is ever run — harness authorship stays a security boundary a
  // sponsor credential cannot reach, unchanged. Null means the sponsor did
  // not request execution verification for this type.
  sponsorHarnessNote String?              @map("sponsor_harness_note")
  difficultyLevels   String[]             @map("difficulty_levels")
  usageCount         Int                  @default(0) @map("usage_count")
  // Provenance for a sponsor fork/adapt (plan G13): the platform type this
  // candidate was cloned + edited from. A fork is a NEW sponsor-authored
  // candidate in its own family (never a version bump of the source), so this
  // is a plain reference for the reviewer diff, not the version chain above.
  forkedFromId       String?              @map("forked_from_id")
  authorUserId       String?              @map("author_user_id")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  author             User?                @relation("AuthoredTypes", fields: [authorUserId], references: [id])
  supersedes         DatasetType?         @relation("DatasetTypeVersionChain", fields: [supersedesId], references: [id], onDelete: Restrict)
  successor          DatasetType?         @relation("DatasetTypeVersionChain")
  bounties           Bounty[]
  datasetRequests    DatasetRequest[]
  harnesses          DatasetTypeHarness[]

  @@unique([familyId, version])
  @@index([familyId, status])
  @@index([status, domain, origin, trustTier, updatedAt])
  @@map("dataset_types")
}

enum DatasetTypeHarnessStatus {
  draft
  proof_pending
  verified
  retired
}

model DatasetTypeHarness {
  id               String                   @id @default(cuid())
  datasetTypeId    String                   @map("dataset_type_id")
  version          Int                      @default(1)
  status           DatasetTypeHarnessStatus @default(draft)
  // The harness.js module source, inlined into the sandbox script with the
  // same registry/lib/helpers.js + run.js wrappers as a registry harness.
  source           String
  sourceSha        String                   @map("source_sha")
  // Runtimes the harness shells out to (setup.sh's role, as data). Purely
  // declarative — the proof run is what actually validates them against the
  // baked sandbox image (a missing one surfaces as runtimeUnavailable).
  declaredRuntimes String[]                 @map("declared_runtimes")
  // Immutable proof-run output: per-sample {expected, actual, logsExcerpt,
  // runtimeUnavailable} plus the sourceSha it proved. Never updated in place.
  proofEvidence    Json?                    @map("proof_evidence")
  // The sample set the last proof was requested with: [{payload, expected,
  // label}]. Kept so the panel can prefill it after a reload — evidence records
  // each sample's VERDICT but deliberately not its payload, so without this an
  // admin had to retype every sample to re-prove an edited harness, and the
  // obvious shortcut (trusting a stale editor buffer) is exactly what the
  // expected-fail requirement exists to prevent. Written on request, never read
  // by the proof job (that reads the job payload), so it can never influence a
  // verdict — it is an editor convenience, not part of the evidence chain.
  proofSamples     Json?                    @map("proof_samples")
  proofJobId       String?                  @map("proof_job_id")
  authorUserId     String?                  @map("author_user_id")
  reviewNote       String?                  @map("review_note")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  datasetType      DatasetType              @relation(fields: [datasetTypeId], references: [id], onDelete: Cascade)
  author           User?                    @relation("AuthoredHarnesses", fields: [authorUserId], references: [id])

  @@unique([datasetTypeId, version])
  @@index([datasetTypeId, status])
  @@map("dataset_type_harnesses")
}

