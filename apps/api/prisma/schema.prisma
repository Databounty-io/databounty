model Submission {
  id                      String           @id @default(cuid())
  bountyId                String           @map("bounty_id")
  slotId                  String?          @map("slot_id")
  contributorBatchId      String?          @map("contributor_batch_id")
  contributorUserId       String           @map("contributor_user_id")
  title                   String
  payloadJson             Json             @map("payload_json")
  generationMethod        GenerationMethod @map("generation_method")
  status                  SubmissionStatus @default(submitted)
  duplicateScore          Float?           @map("duplicate_score")
  // Which layered-dedupe tier produced duplicateScore, and the decision it
  // led to. Mirrors ValidationResult's "dedupe" stage detailJson so the
  // authoritative outcome is also queryable directly off the submission row.
  duplicateMethod         String?          @map("duplicate_method")
  duplicateOfSubmissionId String?          @map("duplicate_of_submission_id")
  duplicateDecision       String?          @map("duplicate_decision")
  // DEPRECATED / unused: external-corpus plagiarism screening was removed
  // from the pipeline entirely per owner decision (services/validation.ts
  // never writes a non-null value here; verified zero non-null rows in the
  // dev database). Column kept rather than dropped — dropping it is a
  // separate, riskier schema migration this cleanup does not make.
  contaminationScore      Float?           @map("contamination_score")
  llmScore                Float?           @map("llm_score")
  revisionCount           Int              @default(0) @map("revision_count")
  validationAttempt       Int              @default(0) @map("validation_attempt")
  acceptedAt              DateTime?        @map("accepted_at")
  // Community open-pool only (COMMUNITY_OPEN_POOL_PLAN_V2 §3.3b): the item
  // tripped a forced-escalation branch during automated validation (near-dup
  // review, execution pending, AI-attribution flag, LLM
  // not-reviewed or uncertain) while the pool was still filling. Instead of
  // routing to a validator immediately (supported-flow behavior), community pools
  // HOLD it in `accepted_pending_sample` and set this flag, so pool close-out
  // can give it GUARANTEED human review (never subject to the random
  // auditCoveragePct draw). Preserves the Trust-or-Escalate invariant while
  // keeping "nothing to a human until the pool is full".
  pendingHumanReview      Boolean          @default(false) @map("pending_human_review")
  // Canonical dedupe key computed at write time (same normalizer as the
  // app-level pre-check). A partial unique index on
  // (bounty_id, contributor_batch_id-or-empty, dedupe_key) WHERE dedupe_key IS
  // NOT NULL AND status <> 'rejected' is added via raw SQL in the migration
  // — Prisma has no partial/expression-unique-index syntax. This is the
  // actual race-free guard:
  // the existingKeys/incomingKeys check in the route only prevents duplicates
  // within a single request, not across two concurrent requests. A P2002 on
  // create/update here means a concurrent request won the race; the caller
  // marks that item rejected as a real duplicate instead of crashing.
  dedupeKey               String?          @map("dedupe_key")
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  bounty                      Bounty                       @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  batch                       ContributorBatch?            @relation(fields: [contributorBatchId], references: [id], map: "submissions_creator_batch_id_fkey")
  contributor                 User                         @relation(fields: [contributorUserId], references: [id], map: "submissions_creator_user_id_fkey")
  validationResults           ValidationResult[]
  flags                       Flag[]
  artifacts                   Artifact[]
  revisions                   SubmissionRevision[]
  lshBands                    SubmissionLshBand[]
  benchmarkTasks              BenchmarkTask[]
  humanAuditWindowMemberships HumanAuditWindowMembership[]
  auditItems                  AuditItem[]

  @@index([bountyId])
  @@index([contributorUserId], map: "submissions_creator_user_id_idx")
  @@index([status])
  // getProfileSummary counts a member's accepted/supported submissions on every
  // dashboard/profile load; this composite turns that COUNT into an
  // index-only scan instead of scanning all of the user's submissions.
  @@index([contributorUserId, status], map: "submissions_creator_user_id_status_idx")
  @@index([contributorUserId, contributorBatchId, createdAt], map: "submissions_creator_user_id_creator_batch_id_created_at_idx")
  // The composite above leads on contributorUserId, so it cannot serve a bare
  // `where: { contributorBatchId }`. This index was originally added to serve
  // a per-batch scan the validation pipeline ran on every validation job for
  // the (now-removed, per owner decision) external-corpus plagiarism stage;
  // kept here as a plain `contributorBatchId` lookup index for any other
  // batch-scoped query, rather than dropped along with that stage.
  @@index([contributorBatchId], map: "submissions_creator_batch_id_idx")
  // Intake dedupe probes `bountyId + dedupeKey IN (...)` for the keys of the
  // rows being inserted. The partial unique index leads on
  // (bounty_id, COALESCE(contributor_batch_id,'')), so dedupe_key is not
  // reachable as a prefix there and the probe degraded to a per-bounty scan.
  @@index([bountyId, dedupeKey])
  // Per-bounty submission lists order/filter by recency (scalability plan
  // §2.3 — both were missing; sponsor evidence view and admin aggregates
  // scan on these).
  @@index([bountyId, createdAt])
  @@index([createdAt])
  // Pool admission (`reservedItems` COUNT WHERE bountyId + status IN (...)) and
  // the pool-lifecycle counters ran WHERE (bountyId, status) with only the
  // single-column bountyId/status indexes — so an open pool's capacity check
  // read every row for that bounty on every submit (O(pool size), under the
  // per-bounty FOR UPDATE lock). This composite makes it an index range scan.
  @@index([bountyId, status], map: "submissions_bounty_id_status_idx")
  @@map("submissions")
}

