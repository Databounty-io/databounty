model NotificationChannel {
  id                  String      @id @default(cuid())
  userId              String      @map("user_id")
  channel             ChannelKind
  address             String
  connected           Boolean     @default(false)
  verified            Boolean     @default(false)
  deliver             Boolean     @default(false)
  // Routine digest delivery is independently controllable for every external
  // channel. It never gates in-app rows or immediate/security/action messages.
  deliverDigest       Boolean     @default(true) @map("deliver_digest")
  verifiedAt          DateTime?   @map("verified_at")
  // Safe, user-visible delivery health. Never store provider response bodies,
  // webhook URLs, OAuth tokens, or other secrets here.
  lastError           String?     @map("last_error")
  lastFailureAt       DateTime?   @map("last_failure_at")
  lastSuccessAt       DateTime?   @map("last_success_at")
  // Email ownership challenge: a hashed one-time code sent to `address` on
  // connect; the channel stays unverified (no delivery) until it's confirmed.
  verifyCodeHash      String?     @map("verify_code_hash")
  verifyCodeExpiresAt DateTime?   @map("verify_code_expires_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@map("notification_channels")
}

