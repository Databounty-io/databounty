}

model JobQueue {
  id             String    @id @default(cuid())
  type           String
  idempotencyKey String    @unique @map("idempotency_key")
  payload        Json
  status         JobStatus @default(pending)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  nextAttemptAt  DateTime? @map("next_attempt_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Multi-tenant fairness partition key for dbJobQueue.claim(): the claim is
  // one atomic FOR UPDATE SKIP LOCKED statement and cannot join out per job
  // type to discover a job's owner, so the tenant travels on the row.
  //
  // Nullable on purpose — several job types have no single owning tenant
  // (artifact.purge_expired_uploads, notifications.fanout_watchers,
  // waitlist.notify_domain_live); claim() gives those their own explicit
  // shared "system" bucket rather than letting them dominate or starve.
  //
  // Deliberately NOT a relation/foreign key: this is an opaque partition key,
  // not a relationship. A queued job must still drain or dead-letter after
  // its tenant is deleted, and enqueue must never fail or block on workspace
  // provisioning (personal workspaces are fire-and-forget in lib/workspace.ts).
  // Values use that layer's deterministic `ws_<userId>` id, so they line up
  // with real Workspace rows wherever those exist.
  workspaceId String? @map("workspace_id")

  // Real execution timing, used to compute the completion estimates the API
  // hands back to callers (services/job-eta.ts → check_submission,
  // get_file_status, and both submit responses).
  //
  // These exist because the honest alternative was arithmetic on
  // `updatedAt - createdAt`, which measures queue wait PLUS execution and so
  // systematically overstates how long the work itself takes — the more
  // backlogged the queue, the more wrong the estimate, which is exactly when
  // an accurate one matters. `startedAt` is stamped by claim() on the first
  // attempt only (a retry must not erase when the job first ran), `finishedAt`
  // by ack()/fail() on reaching a terminal state. Nullable throughout: rows
  // predating this column, and jobs still queued, legitimately have neither.
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@index([type, status, nextAttemptAt])
  @@index([status, nextAttemptAt])
  @@index([type, workspaceId, createdAt])
  // Serves the ETA sampler: "recent completed runs of this type", newest
  // first. Without it, estimating a duration means scanning every finished
  // job of every type.
  @@index([type, finishedAt])
  @@map("job_queue")
}

model Artifact {
  id                  String                      @id @default(cuid())
  kind                ArtifactKind
  visibility          ArtifactVisibility          @default(private)
  status              ArtifactStatus              @default(pending_upload)
  scanStatus          ArtifactScanStatus          @default(not_required) @map("scan_status")
  sponsorReviewStatus SponsorExampleReviewStatus? @map("sponsor_review_status")
  sponsorReviewNote   String?                     @map("sponsor_review_note")
  sponsorReviewedAt   DateTime?                   @map("sponsor_reviewed_at")
  sponsorReviewedBy   String?                     @map("sponsor_reviewed_by")

  // Ownership / tenancy. Every read authz is workspace + role + entity scope,
  // never trusting the client-supplied filename or key.
  workspaceId        String? @map("workspace_id")
  ownerUserId        String? @map("owner_user_id")
  bountyId           String? @map("bounty_id")
  // Pre-mint owners for sponsor reference samples. A community sample is
  // authored while the sponsor is still walking the planner, long before any
  // DatasetRequest row (created on submit) or Bounty row (created on admin
  // mint) exists — so the draft itself has to own it, or a sponsor who leaves
  // mid-flow and resumes later loses their samples.
  //
  // INVARIANT: exactly ONE of plannerSessionId / datasetRequestId / bountyId is
  // set on a sponsor_reference at any time. Carry-forward clears the previous
  // pointer as it sets the next (planner session -> request -> bounty), which is
  // what makes the Cascade rules below safe: a cascade can only ever reach a
  // sample still owned by the stage being deleted.
  plannerSessionId   String? @map("planner_session_id")
  datasetRequestId   String? @map("dataset_request_id")
  submissionId       String? @map("submission_id")
  contributorBatchId String? @map("contributor_batch_id")
  validationResultId String? @map("validation_result_id")

  // Display + integrity metadata. filename is display-only, never used to
  // build the storage key (blocks path traversal).
  filename          String
  contentType       String  @map("content_type")
  declaredSizeBytes BigInt? @map("declared_size_bytes")
  sizeBytes         BigInt? @map("size_bytes")
  checksumSha256    String? @map("checksum_sha256")

  // Storage location. Driver is an adapter id; key is server-generated only.
  storageDriver String  @default("local") @map("storage_driver")
  storageBucket String? @map("storage_bucket")
  storageKey    String  @map("storage_key")

  uploadExpiresAt     DateTime? @map("upload_expires_at")
  // Set only while a large-object (multipart) direct upload is in flight. The
  // provider multipart upload id is required to complete or abort the upload;
  // cleared on completion. A non-null value on an expired pending row tells the
  // cleanup worker to abort the provider-side multipart upload so orphaned
  // parts stop incurring storage cost.
  multipartUploadId   String?   @map("multipart_upload_id")
  versionOfArtifactId String?   @map("version_of_artifact_id")

  // Resumable bulk-source ingest progress (bulk_submission_source only).
  // Cursor is a row/line index into the parsed source — a crashed or retried
  // job re-reads the file but skips everything at or before the cursor, so a
  // multi-million-row source never restarts a chunk it already committed.
  bulkParseStatus      BulkParseStatus @default(not_applicable) @map("bulk_parse_status")
  bulkParseCursor      Int             @default(0) @map("bulk_parse_cursor")
  bulkParseRowCount    Int?            @map("bulk_parse_row_count")
  bulkParseCreated     Int             @default(0) @map("bulk_parse_created")
  /// Rows the parser read but could not use (not JSON, not an object). Counted
  /// rather than silently dropped: without it a source whose rows mostly failed
  /// reported `done` and looked like a clean full ingest.
  bulkParseSkippedRows Int             @default(0) @map("bulk_parse_skipped_rows")
  bulkParseError       String?         @map("bulk_parse_error")

  // Format-registry dimension (FORMAT_REGISTRY_AND_MULTIMODAL_PIPELINE_PLAN.md
  // Phase 1). modality is backfilled from contentType; required going forward.
  modality         ArtifactModality? // backfilled from contentType
  detectedMimeType String?           @map("detected_mime_type") // persists detectFileKind()'s result, not just pass/fail
  parserVersion    String?           @map("parser_version") // handler.version at last successful parse; null = never parsed

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  purgedAt  DateTime? @map("purged_at")

  owner                     User?                    @relation(fields: [ownerUserId], references: [id])
  bounty                    Bounty?                  @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  // Cascade, not SetNull: a discarded draft or cancelled request must not leave
  // a sample row pointing at nothing. Storage objects are a separate concern —
  // the discard/cancel routes soft-delete and enqueue a storage purge BEFORE
  // deleting the parent, so cascade is only the backstop against dangling rows.
  plannerSession            PlannerSession?          @relation(fields: [plannerSessionId], references: [id], onDelete: Cascade)
  datasetRequest            DatasetRequest?          @relation(fields: [datasetRequestId], references: [id], onDelete: Cascade)
  submission                Submission?              @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  validationResult          ValidationResult?        @relation(fields: [validationResultId], references: [id], onDelete: Cascade)
  versionOf                 Artifact?                @relation("ArtifactVersions", fields: [versionOfArtifactId], references: [id])
  uploadReviewDraft         SubmissionUploadDraft?
  versions                  Artifact[]               @relation("ArtifactVersions")
  publicBenchmarkManifests  BenchmarkVersion[]       @relation("BenchmarkVersionPublicManifest")
  privateBenchmarkManifests BenchmarkVersion[]       @relation("BenchmarkVersionPrivateManifest")
  benchmarkRunOutputs       BenchmarkRunTaskResult[] @relation("BenchmarkRunTaskResultOutput")
  datasetPublicationBundles DatasetPublication[]     @relation("DatasetPublicationBundle")

  @@index([bountyId, kind])
  @@index([plannerSessionId, kind])
  @@index([datasetRequestId, kind])
  @@index([submissionId])
  @@index([ownerUserId])
  @@index([status])
  @@map("artifacts")
}

model SubmissionUploadDraft {
  id                     String           @id @default(cuid())
  ownerUserId            String           @map("owner_user_id")
  targetKind             String           @map("target_kind") // claimed_batch | community_pool
  bountyId               String?          @map("bounty_id")
  contributorBatchId     String?          @map("contributor_batch_id")
  generationMethod       GenerationMethod @map("generation_method")
  expectedItemCount      Int?             @map("expected_item_count")
  sourceDescription      String?          @map("source_description")
  // Set only by the authenticated draft contributor as an explicit, one-draft
  // authorization. The browser may submit only a clean parsed source after
  // this timestamp; no authority carries over to another draft.
  autoSubmitAuthorizedAt DateTime?        @map("auto_submit_authorized_at")
  tokenHash              String           @unique @map("token_hash")
  // Second, longer-lived capability minted when the one-time handoff link is
  // redeemed, so the review page works WITHOUT a dashboard session. Stored as
  // an HMAC like tokenHash — never plaintext. Null until redemption; it dies
  // with draftExpiresAt, and cancel/submit clear it so a leaked value cannot
  // be replayed against a finished draft.
  accessTokenHash        String?          @unique @map("access_token_hash")
  tokenExpiresAt         DateTime         @map("token_expires_at")
  draftExpiresAt         DateTime         @map("draft_expires_at")
  redeemedAt             DateTime?        @map("redeemed_at")
  revokedAt              DateTime?        @map("revoked_at")
  sourceArtifactId       String?          @unique @map("source_artifact_id")
  status                 String           @default("awaiting_upload")
  previewSummary         Json?            @map("preview_summary")
  submittedAt            DateTime?        @map("submitted_at")
  // Resume cursor for the `upload_draft.submit` background job — the last
  // `SubmissionUploadDraftItem.rowNumber` this draft has fully committed a
  // Submission (or a skip) for. Row-insert and cursor-advance always happen
  // in the SAME transaction (see services/jobs/upload-draft-submit.ts), so
  // this value and the set of items with `submissionId` set are always
  // consistent even after a crash mid-run.
  submitCursorRowNumber  Int?             @map("submit_cursor_row_number")
  // Honest stop/failure reason for the last submit run (e.g. "pool_full",
  // "pool_closed"), surfaced to the reviewer. Null on a clean full ingest.
  submitError            String?          @map("submit_error")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  owner            User                        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  bounty           Bounty?                     @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  contributorBatch ContributorBatch?           @relation(fields: [contributorBatchId], references: [id], onDelete: Cascade, map: "submission_upload_drafts_creator_batch_id_fkey")
  sourceArtifact   Artifact?                   @relation(fields: [sourceArtifactId], references: [id], onDelete: SetNull)
  items            SubmissionUploadDraftItem[]

  @@index([ownerUserId, status])
  @@index([tokenExpiresAt])
  @@index([draftExpiresAt])
  @@index([bountyId])
  @@index([contributorBatchId], map: "submission_upload_drafts_creator_batch_id_idx")
  @@map("submission_upload_drafts")
}

model SubmissionUploadDraftItem {
  id           String   @id @default(cuid())
  draftId      String   @map("draft_id")
  rowNumber    Int      @map("row_number")
  payload      Json?
  errorCode    String?  @map("error_code")
  errorMessage String?  @map("error_message")
  // Set once this row has become a real Submission (see
  // services/jobs/upload-draft-submit.ts). Per-row idempotency marker: a row
  // with this set must never be submitted again, even on job retry.
  submissionId String?  @map("submission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  draft SubmissionUploadDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, rowNumber])
  @@index([draftId, errorCode])
  @@index([draftId, submissionId])
  @@map("submission_upload_draft_items")
}

model ArtifactProcessingEvent {
  id             String   @id @default(cuid())
  artifactId     String   @map("artifact_id")
  stage          String // "parse" | "preview" | "similarity_check" | ...
  status         String // "passed" | "failed" | "not_supported" | "pending" | "stale"
  handlerVersion String   @map("handler_version")
  detail         Json
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([artifactId])
  @@map("artifact_processing_events")
}

model BenchmarkCorpus {
  id        String          @id @default(cuid())
  name      String // e.g. "coding"
  version   Int             @default(1)
  source    String // e.g. "HumanEval+MBPP+SWE-bench"
  active    Boolean         @default(false) // exactly one active corpus is screened against
  itemCount Int             @default(0) @map("item_count")
  createdAt DateTime        @default(now()) @map("created_at")
  items     BenchmarkItem[]

  @@unique([name, version])
  @@map("benchmark_corpora")
}

model BenchmarkItem {
  id            String          @id @default(cuid())
  corpusId      String          @map("corpus_id")
  // Canonical SHA-256 of the identity fields (same normalizer as dedup).
  canonicalHash String          @map("canonical_hash")
  // k=5 token shingles for MinHash/Jaccard near-match.
  shingles      String[]
  label         String? // e.g. "HumanEval/12"
  corpus        BenchmarkCorpus @relation(fields: [corpusId], references: [id], onDelete: Cascade)

  @@index([corpusId])
  @@index([canonicalHash])
  @@map("benchmark_items")
}

model Benchmark {
  id                 String          @id @default(cuid())
  slug               String          @unique
  title              String
  description        String?
  status             BenchmarkStatus @default(draft)
  supportedDomains   DomainId[]      @map("supported_domains")
  supportedLanguages String[]        @default([]) @map("supported_languages")
  createdByUserId    String          @map("created_by_user_id")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  archivedAt         DateTime?       @map("archived_at")

  createdBy User               @relation("BenchmarkCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions  BenchmarkVersion[]

  @@index([status, createdAt])
  @@map("benchmarks")
}

model BenchmarkVersion {
  id                        String                 @id @default(cuid())
  benchmarkId               String                 @map("benchmark_id")
  version                   Int
  status                    BenchmarkVersionStatus @default(draft)
  // All evaluation-affecting contract settings (scoring, runtime/image,
  // limits, corpus identifiers) are frozen at release creation time.
  contract                  Json
  sourceManifest            Json                   @map("source_manifest")
  sourceManifestSha256      String                 @map("source_manifest_sha256")
  publicManifestArtifactId  String?                @unique @map("public_manifest_artifact_id")
  privateManifestArtifactId String?                @unique @map("private_manifest_artifact_id")
  privateManifestSha256     String?                @map("private_manifest_sha256")
  taskCount                 Int                    @default(0) @map("task_count")
  publicTaskCount           Int                    @default(0) @map("public_task_count")
  privateTaskCount          Int                    @default(0) @map("private_task_count")
  createdByUserId           String                 @map("created_by_user_id")
  approvedByUserId          String?                @map("approved_by_user_id")
  createdAt                 DateTime               @default(now()) @map("created_at")
  frozenAt                  DateTime?              @map("frozen_at")
  validatedAt               DateTime?              @map("validated_at")
  publishedAt               DateTime?              @map("published_at")
  failedAt                  DateTime?              @map("failed_at")
  failureEvidence           Json?                  @map("failure_evidence")

  benchmark               Benchmark       @relation(fields: [benchmarkId], references: [id], onDelete: Restrict)
  createdBy               User            @relation("BenchmarkVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy              User?           @relation("BenchmarkVersionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  publicManifestArtifact  Artifact?       @relation("BenchmarkVersionPublicManifest", fields: [publicManifestArtifactId], references: [id], onDelete: Restrict)
  privateManifestArtifact Artifact?       @relation("BenchmarkVersionPrivateManifest", fields: [privateManifestArtifactId], references: [id], onDelete: Restrict)
  tasks                   BenchmarkTask[]
  runs                    BenchmarkRun[]

  @@unique([benchmarkId, version])
  @@index([benchmarkId, status, version])
  @@index([status, createdAt])
  @@map("benchmark_versions")
}

model BenchmarkTask {
  id                         String             @id @default(cuid())
  benchmarkVersionId         String             @map("benchmark_version_id")
  sourceSubmissionId         String             @map("source_submission_id")
  // A release must pin a concrete immutable submission revision, never a
  // mutable live Submission row. Phase 2 creates that snapshot if necessary.
  sourceSubmissionRevisionId String             @map("source_submission_revision_id")
  split                      BenchmarkTaskSplit
  ordinal                    Int
  taskKey                    String             @map("task_key")
  sourcePayloadSha256        String             @map("source_payload_sha256")
  publicMetadata             Json?              @map("public_metadata")
  privateEvidence            Json?              @map("private_evidence")
  provenanceEvidence         Json               @map("provenance_evidence")
  createdAt                  DateTime           @default(now()) @map("created_at")

  benchmarkVersion BenchmarkVersion         @relation(fields: [benchmarkVersionId], references: [id], onDelete: Restrict)
  sourceSubmission Submission               @relation(fields: [sourceSubmissionId], references: [id], onDelete: Restrict)
  sourceRevision   SubmissionRevision       @relation(fields: [sourceSubmissionRevisionId], references: [id], onDelete: Restrict)
  runResults       BenchmarkRunTaskResult[]

  @@unique([benchmarkVersionId, taskKey])
  @@unique([benchmarkVersionId, ordinal])
  @@index([benchmarkVersionId, split, ordinal])
  @@index([sourceSubmissionId])
  @@index([sourceSubmissionRevisionId])
  @@map("benchmark_tasks")
}

model BenchmarkRun {
  id                 String             @id @default(cuid())
  benchmarkVersionId String             @map("benchmark_version_id")
  status             BenchmarkRunStatus @default(pending)
  idempotencyKey     String             @unique @map("idempotency_key")
  modelProvider      String             @map("model_provider")
  modelName          String             @map("model_name")
  modelVersion       String?            @map("model_version")
  modelConfig        Json               @map("model_config")
  evaluatorImage     String             @map("evaluator_image")
  scoringProfile     Json               @map("scoring_profile")
  requestedByUserId  String?            @map("requested_by_user_id")
  startedAt          DateTime?          @map("started_at")
  completedAt        DateTime?          @map("completed_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  score              Float?
  passedTaskCount    Int                @default(0) @map("passed_task_count")
  evaluatedTaskCount Int                @default(0) @map("evaluated_task_count")
  evidence           Json? // aggregate, immutable outcome evidence
  failureEvidence    Json?              @map("failure_evidence")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  benchmarkVersion BenchmarkVersion         @relation(fields: [benchmarkVersionId], references: [id], onDelete: Restrict)
  requestedBy      User?                    @relation("BenchmarkRunRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  taskResults      BenchmarkRunTaskResult[]

  @@index([benchmarkVersionId, status, createdAt])
  @@index([status, createdAt])
  @@index([modelProvider, modelName, createdAt])
  @@map("benchmark_runs")
}

model BenchmarkRunTaskResult {
  id               String                    @id @default(cuid())
  benchmarkRunId   String                    @map("benchmark_run_id")
  benchmarkTaskId  String                    @map("benchmark_task_id")
  status           BenchmarkTaskResultStatus @default(pending)
  passed           Boolean?
  score            Float?
  durationMs       Int?                      @map("duration_ms")
  outputArtifactId String?                   @unique @map("output_artifact_id")
  evidence         Json // sandbox/image/test-run evidence, no secret inputs
  errorSummary     String?                   @map("error_summary")
  startedAt        DateTime?                 @map("started_at")
  completedAt      DateTime?                 @map("completed_at")
  createdAt        DateTime                  @default(now()) @map("created_at")

  benchmarkRun   BenchmarkRun  @relation(fields: [benchmarkRunId], references: [id], onDelete: Restrict)
  benchmarkTask  BenchmarkTask @relation(fields: [benchmarkTaskId], references: [id], onDelete: Restrict)
  outputArtifact Artifact?     @relation("BenchmarkRunTaskResultOutput", fields: [outputArtifactId], references: [id], onDelete: Restrict)

  @@unique([benchmarkRunId, benchmarkTaskId])
  @@index([benchmarkTaskId])
  @@index([status, createdAt])
  @@map("benchmark_run_task_results")
}

model WaitlistSignup {
  id         String    @id @default(cuid())
  domain     DomainId
  email      String
  createdAt  DateTime  @default(now()) @map("created_at")
  // Set once the "your domain is live" email actually sends. Null means
  // still pending — the real, checkable evidence behind the landing page's
  // "we'll notify you the moment it opens" promise (see waitlist-notify.ts),
  // not just a row nobody ever reads again.
  notifiedAt DateTime? @map("notified_at")

  // Same email joining the same domain's waitlist twice is a no-op, not a
  // second row — the count shown publicly must reflect real distinct
  // signups, not double-submits.
  @@unique([domain, email])
  @@index([domain])
  // Drives the "who's still owed their launch email" scan in
  // processWaitlistNotifyJobs — partial index so it stays tiny (only
  // unnotified rows) instead of scanning every historical signup.
  @@index([domain, notifiedAt])
  @@map("waitlist_signups")
}

// ─────────────────────────────────────────────────────────────────────────────
// Operational telemetry — worker heartbeats, deduped system alerts, the
// organization-owned alert destinations they route to, and the precomputed
// admin quality snapshot.
//
// Ported from v1 (`prisma/schema.prisma:3245-3390`) to close a real parity
// gap: this schema previously had none of these models, so
// `routes/v1/admin-health.ts` returned permanently-empty `workers` and
// `activeAlerts` lists, and `services/admin-quality-metrics.ts` recomputed
// rolling-7-day aggregates on every request because there was no snapshot row
// to read. Both were honest about being empty rather than fabricating green
// rows — but empty is still empty.
//
// Community deviation from v1, deliberate: v1's watchdog also alerts on a
// Redis cache circuit breaker. This API has no cache client at all (searched:
// no redis import anywhere), so that check is not ported and the health
// endpoint keeps reporting `driver: "not_configured"` for cache rather than
// inventing a breaker that cannot open.
// ─────────────────────────────────────────────────────────────────────────────

enum SystemAlertSeverity {
  info
  warning
  critical
}

enum SystemAlertStatus {
  active
  resolved
}

/// Delivery lifecycle for an organization-owned operational alert. Deliberately
/// separate from a user's NotificationDelivery: the company alert channel must
/// survive a staff member being removed or changing roles.
enum OperationalAlertDeliveryStatus {
  pending
  processing
  sent
  failed
  dead
}

model WorkerHeartbeat {
  name       String   @id
  lastRunAt  DateTime @map("last_run_at")
  /// Last tick error message, cleared on the next successful tick.
  lastError  String?  @map("last_error")
  /// The loop's configured cadence, so staleness can be judged per-worker
  /// (a 10min leaderboard sweep isn't stale after 5 minutes; a 15s
  /// dispatcher is).
  intervalMs Int      @map("interval_ms")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("worker_heartbeats")
}

/// Deduped system-alert state: a persisting condition fires ONE admin
/// notification when it first activates (or re-activates after resolving, or
/// escalates in severity) and is auto-resolved with a recovery note when the
/// watchdog sees the condition clear. Also feeds the admin health panel.
model SystemAlert {
  id                    String                     @id @default(cuid())
  code                  String // e.g. "job_backlog", "job_dead_letter", "worker_stale"
  dedupeKey             String                     @unique @map("dedupe_key")
  severity              SystemAlertSeverity
  status                SystemAlertStatus          @default(active)
  context               Json
  firstSeenAt           DateTime                   @default(now()) @map("first_seen_at")
  lastSeenAt            DateTime                   @default(now()) @map("last_seen_at")
  resolvedAt            DateTime?                  @map("resolved_at")
  operationalDeliveries OperationalAlertDelivery[]

  @@index([status, lastSeenAt])
  @@map("system_alerts")
}

/// A shared, admin-owned operational destination (for example the company
/// alert mailbox, a Slack operations channel, or a Telegram alert group).
/// `addressCiphertext` is always encrypted at rest; it is never sent to the
/// browser or written to audit metadata. Individual NotificationChannel rows
/// remain personal preferences and are intentionally not reused here.
model OperationalAlertDestination {
  id                String                     @id @default(cuid())
  name              String
  channel           ChannelKind
  addressCiphertext String                     @map("address_ciphertext")
  verified          Boolean                    @default(false)
  verifiedAt        DateTime?                  @map("verified_at")
  enabled           Boolean                    @default(false)
  minimumSeverity   SystemAlertSeverity        @default(warning) @map("minimum_severity")
  lastError         String?                    @map("last_error")
  lastSuccessAt     DateTime?                  @map("last_success_at")
  createdBy         String                     @map("created_by")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")
  routes            OperationalAlertRoute[]
  deliveries        OperationalAlertDelivery[]

  @@index([enabled, minimumSeverity])
  @@map("operational_alert_destinations")
}

/// Per-destination routing policy. `alertCode` is either "*" (all system
/// alerts) or an exact SystemAlert.code such as "worker_stale". This avoids
/// nullable-unique semantics and gives every routing decision a stable key.
model OperationalAlertRoute {
  id              String                      @id @default(cuid())
  destinationId   String                      @map("destination_id")
  alertCode       String                      @default("*") @map("alert_code")
  minimumSeverity SystemAlertSeverity         @default(warning) @map("minimum_severity")
  enabled         Boolean                     @default(true)
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")
  destination     OperationalAlertDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, alertCode])
  @@index([alertCode, enabled])
  @@map("operational_alert_routes")
}

/// Durable operational-alert outbox. One row is created per alert transition
/// and destination; it is safe to retry and provides provider-specific
/// delivery evidence without exposing the encrypted endpoint.
model OperationalAlertDelivery {
  id            String                         @id @default(cuid())
  alertId       String                         @map("alert_id")
  destinationId String                         @map("destination_id")
  transitionKey String                         @map("transition_key")
  status        OperationalAlertDeliveryStatus @default(pending)
  attempts      Int                            @default(0)
  nextAttemptAt DateTime?                      @map("next_attempt_at")
  sentAt        DateTime?                      @map("sent_at")
  lastError     String?                        @map("last_error")
  createdAt     DateTime                       @default(now()) @map("created_at")
  updatedAt     DateTime                       @updatedAt @map("updated_at")
  alert         SystemAlert                    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  destination   OperationalAlertDestination    @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([alertId, destinationId, transitionKey])
  @@index([status, nextAttemptAt])
  @@map("operational_alert_deliveries")
}

/// Precomputed rolling-7-day quality metrics for the admin overview +
/// submissions list. Without this row both routes recompute four aggregates
/// over `submissions`/`validation_results` on every request.
///
/// DELIBERATE DIVERGENCE from v1 (`prisma/schema.prisma:3375`), which stores
/// four bare `Float` columns. This codebase's `computeCommunityQualityMetrics`
/// returns a per-metric `measured | not_measured | not_configured` state, and
/// four floats cannot represent "not measured" as anything other than `0.0` —
/// which would render an unmeasured metric as a real 0% and violate the
/// project invariant that missing/skipped/unconfigured checks are shown
/// explicitly and never presented as passed. The full computed payload is
/// stored instead, so a snapshot read is exactly as honest as a live compute.
///
/// Not a generic key-value table — one row per named metric set, so a
/// stale/missing row is an explicit, typed condition the route can detect and
/// surface, never silently presented as a real (if outdated) number.
model AdminMetricsSnapshot {
  /// Fixed key for the one row this table holds today ("quality_7d"). A
  /// distinct id (not a singleton-by-convention empty table) so a second
  /// metric set can be added later without a schema change. v1's
  /// `quality_7d_paid` scope has no meaning here.
  id         String   @id
  /// A serialized `CommunityQualityMetrics`, states included.
  payload    Json
  computedAt DateTime @map("computed_at")

  @@map("admin_metrics_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────────
// Validator audit batches and per-item verdicts.
//
// PORTED FROM V1 (`prisma/schema.prisma` AuditBatch/AuditItem) MINUS THE FOUR
// MONEY FIELDS. V1 declares `baseReward`, `issueBonus`, `bondRequired` and
// `bondAmount` (BigInt micro-USDC) on AuditBatch; those are the paid track and
// are omitted per D18. Every other field is neutral and kept verbatim.
//
// Confirmed against live staging before omitting them: all four are zero on
// all 507 batches, so nothing is lost by their absence.
//
// WHY THIS EXISTS ALONGSIDE HumanAuditWindow. V1 runs BOTH models at once, and
// both are community — staging holds 507 batches / 16,988 items against
// community bounties, and 11 windows / 468 memberships. The rebuild had kept
// only the window pair, which meant:
//   * 16,988 community audit records had no table to live in;
//   * a validator's per-item `verdict`/`decidedAt` was derived from
//     `submissions.status` rather than recorded (services/audits.ts:400);
//   * and 422 notes written by validators who APPROVED an item had nowhere at
//     all to go — `flags` only holds reasons for flagged items, so an
//     approving comment was simply unrepresentable.
//
// The window pair models statistical sampling (quota, HMAC selection); this
// pair models the claim-and-decide record. They are not substitutes, which is
// why V1 has both.
//
// NOTE FOR WHOEVER ALIGNS THE VALIDATOR FLOW: no current Community code path
// writes to these tables — `services/audits.ts` drives HumanAuditWindow. This
// pair currently holds migrated V1 history only. That is a deliberate,
// recorded state, not an oversight: the data had to stop being destroyed
// before the flow could be aligned.
// ─────────────────────────────────────────────────────────────────────────────

model AuditBatch {
  id              String    @id @default(cuid())
  bountyId        String    @map("bounty_id")
  validatorUserId String?   @map("validator_user_id")
  itemCount       Int       @map("item_count")
  /// Free-form in V1 too (not an enum): "available", "claimed", "completed",
  /// "overdue_review" are the values present on staging.
  status          String    @default("available")
  deadline        DateTime?
  claimedAt       DateTime? @map("claimed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  bounty      Bounty            @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  validator   User?             @relation(fields: [validatorUserId], references: [id])
  items       AuditItem[]
  /// The sampling window this batch serves, 1:1. Absent on migrated v1 batches,
  /// which predate the window model in this deployment.
  auditWindow HumanAuditWindow?

  @@index([bountyId])
  @@index([status, validatorUserId, deadline, createdAt])
  @@index([validatorUserId, status, claimedAt])
  @@map("audit_batches")
}

model AuditItem {
  id           String        @id @default(cuid())
  auditBatchId String        @map("audit_batch_id")
  submissionId String        @map("submission_id")
  verdict      AuditVerdict?
  flagReason   FlagReason?   @map("flag_reason")
  /// The field with no equivalent anywhere else in this schema: a validator's
  /// written comment, INCLUDING on an approved item. `flags` only carries a
  /// reason/details for flagged submissions, so without this column 422 real
  /// approving notes on staging were unrepresentable.
  note         String?
  decidedAt    DateTime?     @map("decided_at")

  auditBatch AuditBatch @relation(fields: [auditBatchId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id])

  @@index([auditBatchId])
  @@index([submissionId])
  @@map("audit_items")
}
