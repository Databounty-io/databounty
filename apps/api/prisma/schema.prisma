  contributorMissedDeadlines            Int      @default(0) @map("contributor_missed_deadlines")
  contributorAbandons                   Int      @default(0) @map("contributor_abandons")
  contributorConsecutiveCleanDeliveries Int      @default(0) @map("contributor_consecutive_clean_deliveries")
