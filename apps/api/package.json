{
  "name": "databounty-community-api",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "DataBounty Community API — open platform for verified coding datasets (Fastify + Prisma + Postgres)",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:format": "prisma format",
    "migration:safety": "bash scripts/check-migration-safety.sh",
    "schema:assert": "bash scripts/assert-schema-matches.sh",
    "mcp": "tsx src/mcp/stdio.ts",
    "test": "vitest run --maxWorkers=1 --minWorkers=1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/sensible": "^6.0.2",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "e2b": "^2.32.0",
    "fastify": "^5.2.1",
    "http-errors": "^2.0.1",
    "ioredis": "^5.11.1",
    "jimp": "^1.6.1",
    "nodemailer": "^9.1.1",
    "pg": "^8.22.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/http-errors": "^2.0.5",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "pino-pretty": "^13.1.3",
    "prisma": "7.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "qs": "^6.16.0",
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2"
  }
}
