# Community Web (contributor / sponsor / validator dashboard) — copy to .env and fill in.
# Never commit .env itself. All NEXT_PUBLIC_* values are baked into the client bundle at build
# time — do not put secrets in this file.

# --- Where the other apps live ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3010
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_LANDING_URL=http://localhost:3001

# --- Google sign-in (optional; when unset the sign-in UI shows
#     "Google sign-in is not configured (missing client ID)" instead of a
#     broken button — it never fakes a signed-in session) ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Direct (single-request) artifact upload tuning (optional; defaults shown) ---
NEXT_PUBLIC_MAX_UPLOAD_BYTES=104857600
NEXT_PUBLIC_DIRECT_UPLOAD_TIMEOUT_MS=960000

# --- Multipart (chunked) artifact upload tuning (optional; defaults shown) ---
NEXT_PUBLIC_MULTIPART_THRESHOLD_BYTES=104857600
NEXT_PUBLIC_MULTIPART_PART_SIZE_BYTES=16777216
NEXT_PUBLIC_MULTIPART_PART_CONCURRENCY=4
NEXT_PUBLIC_MAX_MULTIPART_UPLOAD_BYTES=5368709120

# --- Build-time output mode (optional; leave unset for a normal `next start` server) ---
# NEXT_OUTPUT=standalone
