# Community Admin (operator console) — copy to .env and fill in.
# Never commit .env itself. All NEXT_PUBLIC_* values are baked into the client bundle at build
# time — do not put secrets in this file. NEXT_PUBLIC_* is inlined by `next build`, so these
# values must be correct at BUILD time, not just runtime — that holds for every output mode
# (served, NEXT_OUTPUT=standalone, NEXT_OUTPUT=export). See next.config.ts.

# --- Where the other apps live ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3010
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_LANDING_URL=http://localhost:3001

# --- Google sign-in for admin login (optional; when unset the sign-in UI
#     reports it is not configured rather than faking a signed-in session) ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
